# HomeSpeaker optional settings. Copy to homespeaker.env next to docker-compose.yml
# (the installer uses /opt/homespeaker/homespeaker.env), then run: docker compose up -d
# The file is optional, and so is every line in it. Most of these can also be set from the /settings page;
# a value here wins over one saved in the settings page.

# --- Nightscout (blood sugar widget) ---
# NIGHTSCOUT_URL=https://your-name.example.com

# --- Govee temperature sensors (climate widget) ---
# Both are needed. Get a key in the Govee Home app: Profile > About > Apply for API Key.
# Temperature__ApiKey=your-govee-api-key
# Temperature__ApiBaseUrl=https://openapi.api.govee.com/router/api/v1/
# Optional: name your rooms ("Room: part of device name, another part; Next room: ...").
# Easier: pick rooms on the /settings page.
# Temperature__Rooms=Outside: Outside; Kitchen: Kitchen, Cook
# Temperature__OutsideRoom=Outside
# Temperature__IndoorRoom=Kitchen

# --- Immich photo slideshow ---
# Without Immich, drop .jpg files into <music folder>/photos instead.
# Immich__BaseUrl=https://immich.example.com
# Immich__AlbumId=your-album-id
# Immich__ApiKey=your-immich-api-key

# --- Admin PIN ---
# Forgot the PIN? Uncomment the next line and run "docker compose up -d": the saved PIN is cleared at startup.
# Then delete the line again, restart, and choose a new PIN on the /settings page.
# Admin__ResetPin=true
