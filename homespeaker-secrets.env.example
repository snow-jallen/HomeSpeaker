# HomeSpeaker secrets file
# Copy this to the file named by HOMESPEAKER_ENV_FILE on each Raspberry Pi (the maintainer's deploy uses
# /home/<deploy user>/homespeaker-secrets.env). Households that used install.sh want homespeaker.env.example instead.
# Every setting below is commented out; uncomment only what you use.
# That file is read by docker-compose at startup and on every manual restart.
# It is never written or overwritten by the GitHub Actions deployment workflow.

# --- Nightscout ---
# Your Nightscout CGM data URL (leave blank to disable the widget)
# NIGHTSCOUT_URL=https://your-name.azurewebsites.net

# --- Govee temperature sensors ---
# Get your API key from the Govee Home app → Profile → About → Apply for API Key
# Both values are required for the temperature widget to appear.
# Temperature__ApiKey=your-govee-api-key-here
# Temperature__ApiBaseUrl=https://openapi.api.govee.com/router/api/v1/

# --- iOS push notifications (APNs) ---
# All four Apns values are required for pushes to send. If any is blank the server logs
# "push notifications are not configured" and sends nothing.
# Topic            = the iOS app's bundle identifier (not a URL).
# TeamId           = 10-char Apple Developer Team ID.
# KeyId            = 10-char Key ID of the APNs Auth Key (.p8).
# PrivateKeyBase64 = the .p8 auth key, base64-encoded on one line: base64 -w0 AuthKey_XXXXXXXXXX.p8
# PushNotifications__Apns__Topic=com.example.HomeSpeaker
# PushNotifications__Apns__TeamId=your-apple-team-id
# PushNotifications__Apns__KeyId=your-apns-key-id
# PushNotifications__Apns__PrivateKeyBase64=base64-encoded-auth-key-p8
# UseSandbox MUST match how the app was built (the .p8 key is the same for both):
#   true  = development build run from Xcode; false = TestFlight / App Store build.
# A mismatch produces BadDeviceToken and the server deactivates the device.
# PushNotifications__Apns__UseSandbox=true
# Optional: seconds between background alert evaluations (default 120, minimum 30).
# PushNotifications__PollIntervalSeconds=120

# --- Weather forecast ---
# Your location, used for the Open-Meteo forecast (no API key needed). Leave blank to disable the forecast.
# Forecast__Latitude=40.7128
# Forecast__Longitude=-74.0060

# --- Immich photo slideshow (ambient screen) ---
# Set the server URL, album ID and API key (Immich__BaseUrl and Immich__AlbumId are blank by default).
# ApiKey: Immich web > Account Settings > API Keys. It needs at least asset.read, asset.view,
# album.read and face.read (or "all").
# Leave this blank to disable the slideshow; the ambient overlays still show on a dark background.
# Immich__BaseUrl=https://immich.example.com
# Immich__AlbumId=your-album-id
# Immich__ApiKey is also accepted as an alternative to IMMICH_API_KEY.
# IMMICH_API_KEY=your-immich-api-key
# Optional:
# Immich__SyncIntervalMinutes=15
# Immich__SlideSeconds=30
# Immich__MaxVideoSeconds=60
# Immich__CacheSize=40
# Immich__RotatePercent=25
# Slideshow videos: pre-download the videos among the next N slides to the Pi (0 disables), skipping any bigger than
# this many MB (0 or less also disables). Prefetch also stops when it would leave under 1 GB free on the cache drive.
# Immich__VideoPrefetchAhead=5
# Immich__VideoPrefetchMaxMB=300
# Ambient__IdleSeconds=60

# --- OpenTelemetry ---
# Where to send logs, traces and metrics. Leave OTEL_EXPORTER_OTLP_ENDPOINT blank to send nothing.
# With the telemetry compose profile: OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18889
# For an OTLP/HTTP collector (e.g. ClickStack/HyperDX), also set the protocol and its ingestion key:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.ts.net:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=authorization=<ingestion API key>
