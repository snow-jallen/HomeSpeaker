@page "/autoplay"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Admin")]
@using HomeSpeaker.Server2.Models
@inject AutoPlayService autoPlayService
@inject HomeSpeakerService svc
@inject IJSRuntime JsRuntime

<PageTitle>Autoplay</PageTitle>

<div class="glass-page glass-page--autoplay">
    <div class="glass-page-header">
        <h1 class="glass-title">Autoplay</h1>
        <div class="glass-page-actions">
            <button type="button" @onclick="SaveSettings" class="glass-btn" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="glass-spinner glass-spinner--inline" role="status" aria-label="Saving"></span>
                }
                else
                {
                    <i class="fas fa-check" aria-hidden="true"></i>
                }
                Save
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="glass-empty" role="status">
            <div class="glass-spinner" aria-hidden="true"></div>
            <span class="visually-hidden">Loading...</span>
        </div>
    }
    else
    {
        <section class="glass-card" aria-label="Autoplay settings">
            <div class="glass-form-grid">
                <label class="glass-field">
                    <span>Silence timeout (minutes)</span>
                    <input type="number" min="1" max="1440" class="glass-input" @bind="settings.SilenceTimeoutMinutes" />
                </label>
                <label class="glass-field">
                    <span>Autoplay volume</span>
                    <input type="number" min="0" max="100" class="glass-input" @bind="settings.VolumeLevel" />
                </label>
            </div>
            <div class="glass-hint">
                When autoplay chooses a playlist, it shuffles that playlist before starting playback.
            </div>
        </section>

        <div class="glass-split">
            <section class="glass-card" aria-labelledby="autoplaySourcesTitle">
                <header class="glass-card-header">
                    <h2 class="glass-card-title" id="autoplaySourcesTitle">Configured sources</h2>
                </header>
                @if (settings.Sources.Count == 0)
                {
                    <div class="glass-empty">No autoplay sources selected.</div>
                }
                else
                {
                    <div class="glass-list">
                        @foreach (var source in settings.Sources)
                        {
                            <div class="glass-row">
                                <span class="glass-badge">@GetSourceTypeLabel(source.SourceType)</span>
                                <div class="glass-row-text">
                                    <div class="glass-row-title" title="@source.DisplayName">@source.DisplayName</div>
                                </div>
                                <div class="glass-row-actions">
                                    <button type="button" class="hs-icon-btn hs-icon-btn--filled" @onclick="() => RemoveSource(source)"
                                            title="Remove @source.DisplayName" aria-label="Remove @source.DisplayName">
                                        <i class="fas fa-trash" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="glass-card" aria-labelledby="autoplayAddTitle">
                <header class="glass-card-header">
                    <h2 class="glass-card-title" id="autoplayAddTitle">Add source</h2>
                </header>
                <div class="glass-field">
                    <span id="autoplayPlaylistLabel">Playlist</span>
                    <div class="glass-input-group">
                        <select class="glass-input" aria-labelledby="autoplayPlaylistLabel" @bind="selectedPlaylistName">
                            <option value="">Select a playlist...</option>
                            @foreach (var playlistName in playlistNames)
                            {
                                <option value="@playlistName">@playlistName</option>
                            }
                        </select>
                        <button type="button" class="glass-btn" @onclick="AddPlaylistSource" disabled="@string.IsNullOrWhiteSpace(selectedPlaylistName)">
                            Add
                        </button>
                    </div>
                </div>

                <div class="glass-field">
                    <span id="autoplayStreamLabel">Stream</span>
                    <div class="glass-input-group">
                        <select class="glass-input" aria-labelledby="autoplayStreamLabel" @bind="selectedStreamIdText">
                            <option value="">Select a stream...</option>
                            @foreach (var stream in streams)
                            {
                                <option value="@stream.Id">@stream.Name</option>
                            }
                        </select>
                        <button type="button" class="glass-btn" @onclick="AddStreamSource" disabled="@string.IsNullOrWhiteSpace(selectedStreamIdText)">
                            Add
                        </button>
                    </div>
                </div>
            </section>
        </div>
    }
</div>

@code {
    private AutoPlaySettingsViewModel settings = new();
    private List<string> playlistNames = new();
    private List<RadioStreamViewModel> streams = new();
    private bool isLoading = true;
    private bool isSaving;
    private string selectedPlaylistName = string.Empty;
    private string selectedStreamIdText = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            settings = await autoPlayService.GetSettingsAsync();
            playlistNames = (await svc.GetPlaylistsAsync())
                .Select(playlist => playlist.Name)
                .OrderBy(name => name, StringComparer.OrdinalIgnoreCase)
                .ToList();
            streams = (await svc.GetRadioStreamsAsync()).ToList();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void AddPlaylistSource()
    {
        if (string.IsNullOrWhiteSpace(selectedPlaylistName) ||
            settings.Sources.Any(source =>
                source.SourceType == AutoPlaySourceType.Playlist &&
                string.Equals(source.PlaylistName, selectedPlaylistName, StringComparison.OrdinalIgnoreCase)))
        {
            selectedPlaylistName = string.Empty;
            return;
        }

        settings.Sources.Add(new AutoPlaySourceViewModel
        {
            SourceType = AutoPlaySourceType.Playlist,
            PlaylistName = selectedPlaylistName,
            DisplayName = selectedPlaylistName
        });
        selectedPlaylistName = string.Empty;
    }

    private void AddStreamSource()
    {
        if (!int.TryParse(selectedStreamIdText, out var streamId))
        {
            selectedStreamIdText = string.Empty;
            return;
        }

        var stream = streams.FirstOrDefault(item => item.Id == streamId);
        if (stream == null || settings.Sources.Any(source => source.SourceType == AutoPlaySourceType.RadioStream && source.RadioStreamId == streamId))
        {
            selectedStreamIdText = string.Empty;
            return;
        }

        settings.Sources.Add(new AutoPlaySourceViewModel
        {
            SourceType = AutoPlaySourceType.RadioStream,
            RadioStreamId = streamId,
            DisplayName = stream.Name
        });
        selectedStreamIdText = string.Empty;
    }

    private void RemoveSource(AutoPlaySourceViewModel source)
    {
        settings.Sources.Remove(source);
    }

    private async Task SaveSettings()
    {
        isSaving = true;

        try
        {
            await autoPlayService.SaveSettingsAsync(settings);
            settings = await autoPlayService.GetSettingsAsync();
            await JsRuntime.InvokeVoidAsync("alert", "Autoplay settings saved.");
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"Failed to save autoplay settings: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private static string GetSourceTypeLabel(AutoPlaySourceType sourceType) =>
        sourceType == AutoPlaySourceType.Playlist ? "Playlist" : "Stream";
}
