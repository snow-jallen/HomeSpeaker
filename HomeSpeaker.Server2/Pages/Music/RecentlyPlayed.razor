@page "/recently-played"
@using HomeSpeaker.Server2.Models
@inject HttpClient Http
@inject ILogger<RecentlyPlayed> Logger

<PageTitle>Home Speaker | Recently Played</PageTitle>

<div class="glass-page">
    <div class="glass-page-header">
        <h1 class="glass-title">Recently Played</h1>
        <div class="glass-page-actions">
            <button @onclick="RefreshRecentlyPlayed" class="glass-btn glass-btn--ghost" title="Refresh">
                <i class="fas fa-sync-alt" aria-hidden="true"></i>
                <span>Refresh</span>
            </button>
        </div>
    </div>

    @if (recentSongs == null)
    {
        <div class="glass-empty" role="status">
            <div class="glass-spinner" aria-hidden="true"></div>
            Loading recently played songs...
        </div>
    }
    else if (!recentSongs.Any())
    {
        <div class="glass-empty">
            <i class="fas fa-clock-rotate-left" aria-hidden="true"></i>
            <div><strong>No recently played songs</strong></div>
            <div>Songs you play will appear here!</div>
        </div>
    }
    else
    {
        <div class="glass-list">
            @foreach (var song in recentSongs)
            {
                <Song SongViewModel="song" ShowArtist="true" />
            }
        </div>
    }
</div>

@code {
    private List<SongViewModel>? recentSongs;

    protected override async Task OnInitializedAsync()
    {
        await RefreshRecentlyPlayed();
    }

    async Task RefreshRecentlyPlayed()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<RecentSongDto>>("/api/music/recently-played?limit=20");
            recentSongs = response?.Select(s => new SongViewModel
            {
                SongId = s.SongId,
                Name = s.Name,
                Path = s.Path,
                Album = s.Album ?? "",
                Artist = s.Artist ?? ""
            }).ToList() ?? new List<SongViewModel>();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading recently played songs");
            recentSongs = new List<SongViewModel>();
        }
    }

    private class RecentSongDto
    {
        public int SongId { get; set; }
        public string Name { get; set; } = "";
        public string Path { get; set; } = "";
        public string? Album { get; set; }
        public string? Artist { get; set; }
    }
}
