@page "/playlists"
@inject HomeSpeakerService svc
@inject ILogger<Playlists> Logger

<PageTitle>Home Speaker | Playlists</PageTitle>

<div class="glass-page">
    <div class="glass-page-header">
        <h1 class="glass-title">Playlists</h1>
        <div class="glass-page-actions">
            <button @onclick="RefreshPlaylists" class="glass-btn glass-btn--ghost" title="Refresh playlists">
                <i class="fas fa-sync-alt" aria-hidden="true"></i>
                <span>Refresh</span>
            </button>
        </div>
    </div>

    @if (playlists == null)
    {
        <div class="glass-empty" role="status">
            <div class="glass-spinner" aria-hidden="true"></div>
            Loading playlists...
        </div>
    }
    else if (!playlists.Any())
    {
        <div class="glass-empty">
            <i class="fas fa-list-ul" aria-hidden="true"></i>
            <div><strong>No playlists found</strong></div>
            <div>Create your first playlist by adding songs from the library!</div>
        </div>
    }
    else
    {
        <div class="glass-list">
            @foreach (var playlist in playlists)
            {
                <PlaylistItem @key="playlist.Name" Playlist=@playlist OnPlaylistChanged="RefreshPlaylists" />
            }
        </div>
    }
</div>

@code {
    IEnumerable<Playlist>? playlists;

    protected override async Task OnInitializedAsync()
    {
        await RefreshPlaylists();
    }

    async Task RefreshPlaylists()
    {
        try
        {
            playlists = await svc.GetPlaylistsAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error refreshing playlists");
            playlists = Enumerable.Empty<Playlist>();
        }
    }
}
