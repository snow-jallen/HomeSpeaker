@page "/Queue"
@using System.Globalization
@inject HomeSpeakerService svc
@inject IJSRuntime JSRuntime
@inject ILogger<Queue> logger
@inject ILocalQueueService localQueueService
@inject PlayerStateService PlayerState
@implements IDisposable

<div class="glass-page glass-page--queue">
    <div class="glass-page-header">
        <h1 class="glass-title">Playback Queues</h1>
        <div class="glass-page-actions">
            <button @onclick=refresh type="button" title="Refresh queue" aria-label="Refresh queue" class="hs-icon-btn hs-icon-btn--filled">
                <i class="fas fa-rotate-right" aria-hidden="true"></i>
            </button>
        </div>
    </div>

    <!-- Bootstrap Tabs -->
    <ul class="nav glass-tabs" id="queueTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="server-tab" data-bs-toggle="tab" data-bs-target="#server-queue" type="button" role="tab" aria-controls="server-queue" aria-selected="true">
                Server Queue (@(queue?.Count.ToString("n0") ?? "0"))
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="local-tab" data-bs-toggle="tab" data-bs-target="#local-queue" type="button" role="tab" aria-controls="local-queue" aria-selected="false">
                Local Queue (@(localQueueService.Queue.Count.ToString("n0")))
            </button>
        </li>
    </ul>

    <div class="tab-content" id="queueTabContent">
        <!-- Server Queue Tab -->
        <div class="tab-pane fade show active" id="server-queue" role="tabpanel" aria-labelledby="server-tab">
            <div class="glass-page">
                <!-- Now Playing Card -->
                @if (PlayerState.Status?.CurrentSong is { } current)
                {
                    var np = NowPlayingInfo.From(PlayerState.Status);
                    var artSongId = np is null ? current.SongId : np.SongId;
                    <section class="glass hs-np-card hs-np-card--wide" aria-label="Now playing">
                        <div class="hs-np-head">
                            @if (np?.IsStream == true)
                            {
                                <div class="hs-art hs-art--lg hs-art--radio">
                                    <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="2"></circle><path d="M16.2 7.8a6 6 0 0 1 0 8.4M7.8 16.2a6 6 0 0 1 0-8.4M19 5a10 10 0 0 1 0 14M5 19A10 10 0 0 1 5 5"></path></svg>
                                </div>
                            }
                            else if (artSongId is { } songId)
                            {
                                <div class="hs-art hs-art--lg" style="background-image:url('/api/homespeaker/songs/@songId/art')"></div>
                            }
                            else
                            {
                                <div class="hs-art hs-art--lg hs-art--radio" aria-hidden="true"></div>
                            }
                            <div class="hs-np-text">
                                <div class="hs-np-title">@(np?.Title ?? current.Name)</div>
                                @if (np?.Subtitle is { } subtitle)
                                {
                                    <div class="hs-np-sub">@subtitle</div>
                                }
                            </div>
                            <div class="hs-np-actions">
                                <PlayControls />
                            </div>
                        </div>
                        @if (np is { IsStream: false })
                        {
                            <div>
                                <div class="hs-progress hs-progress--lg"><div style="width:@((np.Percent * 100).ToString("F1", CultureInfo.InvariantCulture))%"></div></div>
                                <div class="hs-np-times"><span>@formatTime(np.Elapsed)</span><span>-@formatTime(np.Remaining)</span></div>
                            </div>
                        }
                        <label class="hs-volume">
                            <span class="visually-hidden">Volume</span>
                            <i class="fas fa-volume-up" aria-hidden="true"></i>
                            <input type="range" min="0" max="100"
                                   value="@volumeLevel"
                                   @oninput="@(e => { if (int.TryParse(e.Value?.ToString(), out var v)) { volumeLevel = v; isDraggingVolume = true; } })"
                                   @onchange="OnVolumeChanged" />
                            <span class="glass-volume-value">@volumeLevel%</span>
                        </label>
                    </section>
                }
                else
                {
                    <label class="glass glass-volume-card hs-volume">
                        <span class="visually-hidden">Volume</span>
                        <i class="fas fa-volume-up" aria-hidden="true"></i>
                        <input type="range" min="0" max="100"
                               value="@volumeLevel"
                               @oninput="@(e => { if (int.TryParse(e.Value?.ToString(), out var v)) { volumeLevel = v; isDraggingVolume = true; } })"
                               @onchange="OnVolumeChanged" />
                        <span class="glass-volume-value">@volumeLevel%</span>
                    </label>
                }

                <div class="glass-queue-head">
                    <div class="glass-queue-head-text">
                        <h2 class="glass-section-title">Server Queue</h2>
                        <div class="glass-hint">(@CountText.Songs(queue?.Count() ?? 0) • drag to reorder)</div>
                    </div>
                    <div class="glass-page-actions">
                        <button @onclick=ShuffleQueue
                                type="button"
                                class="glass-btn glass-btn--ghost"
                                disabled="@(queue?.Count <= 1)"
                                title="Shuffle queue"
                                aria-label="Shuffle queue">
                            <i class="fas fa-random" aria-hidden="true"></i><span class="glass-btn-label">Shuffle</span>
                        </button>
                        <button @onclick=ClearQueue
                                type="button"
                                class="glass-btn glass-btn--danger"
                                disabled="@(queue?.Count == 0)"
                                title="Clear queue"
                                aria-label="Clear queue">
                            <i class="fas fa-trash" aria-hidden="true"></i><span class="glass-btn-label">Clear Queue</span>
                        </button>
                        <button @onclick=saveQueueAsPlaylist
                                type="button"
                                title="Save server queue as playlist"
                                aria-label="Save server queue as playlist"
                                class="glass-btn glass-btn--ghost"
                                disabled="@(queue?.Count == 0)">
                            <i class="fas fa-save" aria-hidden="true"></i><span class="glass-btn-label">Save as Playlist</span>
                        </button>
                    </div>
                </div>

                @if (queue?.Any() == true)
                {
                    <div class="glass-list">
                        @for (int i = 0; i < queue.Count; i++)
                        {
                            var song = queue[i];
                            var index = i;
                            var isCurrentSong = PlayerState.Status?.CurrentSong?.Name != null && song.Name == PlayerState.Status.CurrentSong.Name;

                            <div class="glass-queue-item @(serverDraggedIndex == index ? "dragging" : "") @(serverDropTargetIndex == index ? "drop-target" : "")"
                                 data-index="@index"
                                 draggable="true"
                                 @ondragstart="@(() => StartServerDrag(index))"
                                 @ondragover="@((e) => HandleServerDragOver(e, index))"
                                 @ondragover:preventDefault="true"
                                 @ondrop="@(() => DropServer(index))"
                                 @ondragenter="@(() => HandleServerDragEnter(index))"
                                 @ondragleave="@(() => HandleServerDragLeave(index))"
                                 @ondragend="@(() => HandleServerDragEnd())">
                                <QueueItem SongViewModel="song"
                                         Removed="removeFromQueue"
                                         QueuePosition="@(index + 1)"
                                         IsCurrentSong="@isCurrentSong" />
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="glass-empty">
                        <i class="fas fa-music" aria-hidden="true"></i>
                        <div class="glass-row-title">No songs in server queue</div>
                        <p class="mb-0">Use "Play on Server" from any play button to add songs here</p>
                    </div>
                }
            </div>
        </div>

        <!-- Local Queue Tab -->
        <div class="tab-pane fade" id="local-queue" role="tabpanel" aria-labelledby="local-tab">
            <div class="glass-page">
                <LocalAudioPlayer />
                <LocalQueueDisplay />
            </div>
        </div>
    </div>
</div>

@code {
    // Server drag and drop variables
    private int serverDraggedIndex = -1;
    private int? serverDropTargetIndex = null;

    int volumeLevel = 50;
    bool isDraggingVolume;

    private async Task OnVolumeChanged(ChangeEventArgs e)
    {
        isDraggingVolume = false;
        if (int.TryParse(e.Value?.ToString(), out var v))
        {
            try
            {
                await svc.SetVolumeAsync(v);
            }
            catch (Exception ex)
            {
                logger.LogError(ex, "Failed to set volume to {volume}", v);
            }
        }
    }

    List<SongViewModel> queue = new();

    protected override async Task OnInitializedAsync()
    {
        PlayerState.StateChanged += OnStateChanged;
        await refresh();
        svc.QueueChanged += OnQueueChanged;

        // Subscribe to local queue changes to update tab counts
        localQueueService.QueueChanged += OnLocalQueueChanged;

        try
        {
            volumeLevel = await svc.GetVolumeAsync();
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Failed to get initial volume level");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Initialize Bootstrap tabs
            await JSRuntime.InvokeVoidAsync("initializeTabs");
        }
    }

    async Task saveQueueAsPlaylist()
    {
        var newPlaylistName = String.Format("From Queue {0:ddd d MMM hh:mm tt}", DateTime.UtcNow.ToLocalTime());
        foreach (var song in queue)
        {
            if (!string.IsNullOrEmpty(song.Path))
            {
                try
                {
                    await svc.AddToPlaylistAsync(newPlaylistName, song.Path);
                }
                catch (Exception ex)
                {
                    logger.LogError(ex, "Failed to add song {songPath} to playlist {playlistName}", song.Path, newPlaylistName);
                }
            }
        }
    }

    async Task ShuffleQueue()
    {
        await svc.ShuffleQueueAsync();
        await refresh();
    }

    async Task ClearQueue()
    {
        await svc.ClearQueueAsync();
        await refresh();
    }

    async Task removeFromQueue(SongViewModel song)
    {
        queue.Remove(song);
        await svc.UpdateQueueAsync(queue);
    }

    private void OnStateChanged() => InvokeAsync(() =>
    {
        // Reflect volume changes from other clients or the physical knob, but not
        // while the user is actively dragging this slider.
        if (!isDraggingVolume)
            volumeLevel = PlayerState.Volume;
        StateHasChanged();
    });

    private async void OnQueueChanged(object? sender, EventArgs e)
    {
        try
        {
            logger.LogInformation("The QueueChanged event was raised.  Refreshing.");
            await refresh();
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error handling queue change event");
        }
    }

    private void OnLocalQueueChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    async Task refresh()
    {
        queue.Clear();
        queue.AddRange(await svc.GetPlayQueueAsync());
        var status = await svc.GetStatusAsync();
        PlayerState.UpdateStatus(status);
        StateHasChanged();
    }

    private static string formatTime(TimeSpan time) =>
        time.ToString(time.TotalHours >= 1 ? @"h\:mm\:ss" : @"m\:ss", CultureInfo.InvariantCulture);

    // Server queue drag and drop methods
    private void StartServerDrag(int index)
    {
        serverDraggedIndex = index;
        logger.LogInformation("Started dragging server queue item at index {index}", index);
    }

    private void HandleServerDragOver(DragEventArgs e, int index)
    {
        if (serverDraggedIndex >= 0 && serverDraggedIndex != index)
        {
            serverDropTargetIndex = index;
            e.DataTransfer.DropEffect = "move";
        }
    }

    private void HandleServerDragEnter(int index)
    {
        if (serverDraggedIndex >= 0 && serverDraggedIndex != index)
        {
            serverDropTargetIndex = index;
        }
    }

    private void HandleServerDragLeave(int index)
    {
        if (serverDropTargetIndex == index)
        {
            serverDropTargetIndex = null;
        }
    }

    private void HandleServerDragEnd()
    {
        serverDraggedIndex = -1;
        serverDropTargetIndex = null;
        StateHasChanged();
    }

    private async Task DropServer(int targetIndex)
    {
        logger.LogInformation("Server drop called: draggedIndex={draggedIndex}, targetIndex={targetIndex}", serverDraggedIndex, targetIndex);

        if (serverDraggedIndex < 0 || serverDraggedIndex >= queue.Count ||
            targetIndex < 0 || targetIndex >= queue.Count ||
            serverDraggedIndex == targetIndex)
        {
            logger.LogWarning("Invalid server drop operation: draggedIndex={draggedIndex}, targetIndex={targetIndex}, queueCount={count}",
                serverDraggedIndex, targetIndex, queue.Count);
            HandleServerDragEnd();
            return;
        }

        try
        {
            logger.LogInformation("Moving server queue song from index {fromIndex} to {toIndex}", serverDraggedIndex, targetIndex);

            // Update the local queue order
            var song = queue[serverDraggedIndex];
            queue.RemoveAt(serverDraggedIndex);
            queue.Insert(targetIndex, song);

            // Update the server with the new queue order
            await svc.UpdateQueueAsync(queue);

            logger.LogInformation("Successfully moved server queue song from index {fromIndex} to {toIndex}", serverDraggedIndex, targetIndex);
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error reordering server queue from index {draggedIndex} to {targetIndex}", serverDraggedIndex, targetIndex);
            // Refresh the queue from server on error
            await refresh();
        }
        finally
        {
            HandleServerDragEnd();        }
    }

    public void Dispose()
    {
        PlayerState.StateChanged -= OnStateChanged;
        svc.QueueChanged -= OnQueueChanged;
        localQueueService.QueueChanged -= OnLocalQueueChanged;
    }
}

