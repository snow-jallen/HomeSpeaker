@page "/music"
@inject HomeSpeakerService svc
@inject ILogger<Music> logger
@implements IDisposable

<PageTitle>Home Speaker | Music</PageTitle>

<div class="glass-page">
    <div class="glass-page-header">
        <h1 class="glass-title">Music Library</h1>
        <div class="glass-page-actions">
            <button @onclick=reloadSongsAsync class="glass-btn glass-btn--ghost" title="Refresh library">
                <i class="fas fa-sync-alt" aria-hidden="true"></i>
                <span>Refresh</span>
            </button>
        </div>
    </div>

    <div class="glass-search-row">
        <input type="search" class="glass-input" placeholder="Search library…" aria-label="Search artists, albums, or songs" @bind="FilterValue" @bind:event="onchange" />
        <button @onclick=refresh class="glass-btn" title="Search" aria-label="Search">
            <i class="fas fa-search" aria-hidden="true"></i>
            <span class="glass-btn-label">Search</span>
        </button>
    </div>

    @if (songs == null)
    {
        <div class="glass-empty" role="status">
            <div class="glass-spinner" aria-hidden="true"></div>
            Loading your music library...
        </div>
    }
    else if (libraryEmpty)
    {
        <div class="glass-empty">
            <i class="fas fa-music" aria-hidden="true"></i>
            <div>No music yet. Add MP3s to the media folder, or save songs from YouTube.</div>
        </div>
    }
    else if (numPages == 0)
    {
        <div class="glass-empty">
            <i class="fas fa-search" aria-hidden="true"></i>
            <div>No artists, albums, or songs contain '@FilterValue'</div>
            <button class="glass-btn glass-btn--ghost mt-3" @onclick="() => FilterValue = null">
                Clear search
            </button>
        </div>
    }
    else
    {
        @if (numPages > 1)
        {
            <div class="glass-pager">
                <button class="glass-btn glass-btn--ghost" @onclick=@(()=>pageNum--) disabled=@(pageNum == 0)>
                    <i class="fas fa-chevron-left" aria-hidden="true"></i>Prev
                </button>
                <div class="glass-pager-info">
                    Page <strong>@(pageNum + 1)</strong> of <strong>@numPages</strong>
                    <span class="glass-pager-extra">(@artistCount artists)</span>
                </div>
                <button class="glass-btn glass-btn--ghost" @onclick=@(()=>pageNum++) disabled=@(pageNum+1 >= numPages)>
                    Next<i class="fas fa-chevron-right" aria-hidden="true"></i>
                </button>
            </div>
        }

        <div class="glass-list">
            @foreach (var artist in (artists?.Skip(pageSize * pageNum).Take(pageSize)) ?? Enumerable.Empty<IGrouping<string, SongViewModel>>())
            {
                <Artist Content="@artist" />
            }
        </div>

        @if (numPages > 1)
        {
            <div class="glass-pager glass-pager--center">
                <button class="glass-btn glass-btn--ghost" @onclick=@(()=>pageNum=0) disabled=@(pageNum == 0)>
                    <i class="fas fa-angle-double-up" aria-hidden="true"></i>Back to top
                </button>
            </div>
        }
    }
</div>

@code {
    private int pageNum = 0;
    private int pageSize = 200;
    private int numPages = 0;
    private int artistCount;
    private string? filterValue;
    private bool libraryEmpty;

    public string? FilterValue
    {
        get => filterValue;
        set
        {
            logger.LogInformation("Setting FilterValue to {value}", value);
            filterValue = value;
            refresh();
        }
    }

    IEnumerable<SongViewModel>? songs;
    IOrderedEnumerable<IGrouping<string, SongViewModel>>? artists;

    protected override async Task OnInitializedAsync()
    {
        svc.LibraryChanged += OnLibraryChanged;
        await reloadSongsAsync();
    }

    private void OnLibraryChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                await reloadSongsAsync();
            }
            catch (Exception ex)
            {
                logger.LogError(ex, "Error reloading songs after library change");
            }
        });
    }

    public void Dispose()
    {
        svc.LibraryChanged -= OnLibraryChanged;
    }

    async Task reloadSongsAsync()
    {
        songs = null;
        StateHasChanged();
        songs = await svc.GetAllSongsAsync();
        libraryEmpty = !songs.Any();
        FilterValue = null;
        refresh();
    }

    void refresh()
    {
        if (songs == null) return;

        var filteredSongs = songs;
        if (!string.IsNullOrWhiteSpace(FilterValue))
        {
            filteredSongs = songs.Where(a =>
                (a.Artist?.Contains(FilterValue, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.Album?.Contains(FilterValue, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.Name?.Contains(FilterValue, StringComparison.OrdinalIgnoreCase) ?? false)
            );
        }

        artists = from s in filteredSongs
                  group s by s.Artist into artists
                  orderby artists.Key
                  select artists;
        artistCount = artists?.Count() ?? 0;
        numPages = (artistCount + pageSize - 1) / pageSize;
    }
}
