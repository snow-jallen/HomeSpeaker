@page "/ai-status"
@inject HomeSpeakerService svc
@inject ILogger<AiStatus> Logger
@implements IDisposable
@attribute [StreamRendering]

<PageTitle>AI Processing Status</PageTitle>

<div class="glass-page glass-page--ai">
    <div class="glass-page-header">
        <h1 class="glass-title">AI Processing Status</h1>
        <div class="glass-page-actions">
            <button type="button" @onclick="RefreshStatus" class="glass-btn glass-btn--ghost" title="Refresh status" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="glass-spinner glass-spinner--inline" role="status" aria-hidden="true"></span>
                    <span>Refreshing...</span>
                }
                else
                {
                    <i class="fas fa-sync-alt" aria-hidden="true"></i><span>Refresh</span>
                }
            </button>
        </div>
    </div>

    @if (!hasLoaded && isLoading)
    {
        <div class="glass-empty" role="status">
            <div class="glass-spinner" aria-hidden="true"></div>
            <span class="visually-hidden">Loading status...</span>
        </div>
    }
    else
    {
        @if (isLoading)
        {
            <div class="glass-hint glass-ai-refreshing" aria-live="polite">
                <span class="glass-spinner glass-spinner--inline" aria-hidden="true"></span>
                <span>Updating AI status…</span>
            </div>
        }

        <div class="glass-ai-status-top">
            <!-- State Card -->
            <div class="@StatusCardClass">
                <div class="glass-ai-status-icon">
                    @if (status.State == "Processing")
                    {
                        <i class="fas fa-spinner fa-pulse" aria-hidden="true"></i>
                    }
                    else if (status.State == "Scanning")
                    {
                        <i class="fas fa-search" aria-hidden="true"></i>
                    }
                    else if (status.State == "Degraded")
                    {
                        <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
                    }
                    else
                    {
                        <i class="fas fa-check-circle" aria-hidden="true"></i>
                    }
                </div>
                <div class="glass-ai-card-body">
                    <div class="glass-section-title">Status</div>
                    <div class="glass-ai-big">@status.State</div>
                </div>
            </div>

            <!-- Progress Card -->
            <div class="glass-ai-status-card">
                <div class="glass-ai-card-body">
                    <div class="glass-section-title">Progress</div>
                    <div class="glass-ai-big">@status.PercentComplete.ToString("F1")%</div>
                    <div class="hs-progress hs-progress--lg glass-ai-progress"
                         role="progressbar"
                         aria-label="AI analysis progress"
                         aria-valuenow="@status.PercentComplete"
                         aria-valuemin="0"
                         aria-valuemax="100">
                        <div style="width: @(status.PercentComplete)%"></div>
                    </div>
                </div>
            </div>
        </div>

        <section class="glass-ai-panel" aria-labelledby="ai-activity-heading" aria-live="polite">
            <div class="glass-ai-panel-head">
                <div>
                    <div class="glass-section-title">Recent activity</div>
                    <h2 id="ai-activity-heading" class="glass-ai-h2">Live enrichment timeline</h2>
                    <p class="glass-hint">The newest worker updates stay here so you can see what AI enrichment is doing right now.</p>
                </div>

                <div class="glass-ai-panel-meta">
                    <span class="glass-ai-count">@VisibleActivity.Count @(VisibleActivity.Count == 1 ? "entry" : "entries")</span>

                    @if (!string.IsNullOrWhiteSpace(status.CurrentBatchId))
                    {
                        <span class="glass-ai-count">Batch @ShortBatchId(status.CurrentBatchId)</span>
                    }
                </div>
            </div>

            @if (VisibleActivity.Count > 0)
            {
                <div class="glass-ai-activity" role="list">
                    @foreach (var activity in VisibleActivity)
                    {
                        <article class="@GetActivityItemClass(activity)" role="listitem">
                            <span class="glass-ai-activity-dot">
                                <i class="@GetActivityIcon(activity)" aria-hidden="true"></i>
                            </span>

                            <div class="glass-ai-activity-body">
                                <div class="glass-ai-activity-meta">
                                    <span class="glass-ai-activity-kind">@GetActivityLabel(activity)</span>
                                    <time class="glass-ai-activity-time" datetime="@activity.TimestampUtc.ToString("O")">
                                        @FormatActivityTimestamp(activity.TimestampUtc)
                                    </time>
                                </div>

                                <p class="glass-ai-activity-message">@activity.Message</p>

                                @if (!string.IsNullOrWhiteSpace(activity.BatchId))
                                {
                                    <div class="glass-ai-activity-time">Batch @ShortBatchId(activity.BatchId)</div>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="glass-empty" role="status">
                    <i class="fas fa-wave-square" aria-hidden="true"></i>
                    <div class="glass-row-title">No activity yet</div>
                    <p class="mb-0">@ActivityEmptyMessage</p>
                </div>
            }
        </section>

        @if (IsDegraded && HasDegradedDetails)
        {
            <section class="glass-alert glass-alert--danger glass-ai-alert" role="alert" aria-live="polite">
                <i class="fas fa-circle-exclamation" aria-hidden="true"></i>
                <div class="glass-ai-alert-body">
                    <div class="glass-row-title">AI processing needs attention</div>
                    <p class="glass-ai-alert-text">@(status.DegradedReason ?? "The AI pipeline reported a degraded state.")</p>

                    @if (!string.IsNullOrWhiteSpace(status.LastErrorMessage))
                    {
                        <div class="glass-ai-alert-block">
                            <div class="glass-section-title">Most recent error</div>
                            <div>@status.LastErrorMessage</div>
                        </div>
                    }

                    @if (status.ErrorDetails.Count > 0)
                    {
                        <div class="glass-ai-alert-block">
                            <div class="glass-section-title">Reported details</div>
                            <ul class="glass-ai-alert-list">
                                @foreach (var detail in status.ErrorDetails)
                                {
                                    <li>@detail</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(status.CurrentBatchId))
                    {
                        <div class="glass-ai-alert-meta">Batch ID: @status.CurrentBatchId</div>
                    }

                    @if (status.LastFailureUtc.HasValue)
                    {
                        <div class="glass-ai-alert-meta">Last failure: @FormatDateTime(status.LastFailureUtc.Value)</div>
                    }
                </div>
            </section>
        }

        <!-- Stats Grid -->
        <div class="glass-ai-stats">
            <div class="glass-ai-stat">
                <div class="glass-ai-stat-label">Total Tracks</div>
                <div class="glass-ai-stat-value">@status.TotalTracks</div>
            </div>
            <div class="glass-ai-stat">
                <div class="glass-ai-stat-label">Completed</div>
                <div class="glass-ai-stat-value glass-ai-tone-ok">@status.CompletedTracks</div>
            </div>
            <div class="glass-ai-stat">
                <div class="glass-ai-stat-label">Queued</div>
                <div class="glass-ai-stat-value glass-ai-tone-info">@status.QueuedTracks</div>
            </div>
            <div class="glass-ai-stat">
                <div class="glass-ai-stat-label">Processing</div>
                <div class="glass-ai-stat-value glass-ai-tone-warn">@status.ProcessingTracks</div>
            </div>
            <div class="glass-ai-stat">
                <div class="glass-ai-stat-label">Failed</div>
                <div class="glass-ai-stat-value glass-ai-tone-bad">@status.FailedTracks</div>
            </div>
        </div>

        <!-- Timestamps -->
        @if (status.LastScanUtc.HasValue || status.LastHeartbeatUtc.HasValue)
        {
            <div class="glass-ai-times">
                @if (status.LastScanUtc.HasValue)
                {
                    <div class="glass-ai-time-row">
                        <i class="fas fa-clock" aria-hidden="true"></i>
                        <span>Last scan: @FormatDateTime(status.LastScanUtc.Value)</span>
                    </div>
                }

                @if (status.LastHeartbeatUtc.HasValue)
                {
                    <div class="glass-ai-time-row">
                        <i class="fas fa-heartbeat" aria-hidden="true"></i>
                        <span>Last activity: @FormatDateTime(status.LastHeartbeatUtc.Value)</span>
                    </div>
                }
            </div>
        }

        <!-- Actions -->
        @if (status.State == "Idle" && status.QueuedTracks > 0)
        {
            <button type="button" @onclick="ResumeProcessing"
                    class="glass-btn glass-ai-resume"
                    title="Resume AI processing">
                <i class="fas fa-play" aria-hidden="true"></i>Resume Processing
            </button>
        }

        <!-- Info Banner -->
        <div class="glass-ai-banner">
            <div class="glass-ai-banner-icon">
                <i class="fas fa-info-circle" aria-hidden="true"></i>
            </div>
            <p class="glass-ai-banner-copy">The AI analyzes your music library to create intelligent playlists based on mood, energy, and genre.</p>
        </div>
    }
</div>

@code {
    private AiLibraryStatus status = new();
    private bool isLoading = true;
    private bool hasLoaded;
    private System.Threading.Timer? refreshTimer;
    private bool IsDegraded => string.Equals(status.State, "Degraded", StringComparison.OrdinalIgnoreCase);
    private bool HasDegradedDetails =>
        !string.IsNullOrWhiteSpace(status.DegradedReason) ||
        !string.IsNullOrWhiteSpace(status.LastErrorMessage) ||
        status.LastFailureUtc.HasValue ||
        status.ErrorDetails.Count > 0 ||
        !string.IsNullOrWhiteSpace(status.CurrentBatchId);
    private string StatusCardClass => IsDegraded ? "glass-ai-status-card glass-ai-status-card--degraded" : "glass-ai-status-card";
    private IReadOnlyList<AiStatusActivity> VisibleActivity => status.RecentActivity.Take(20).ToArray();
    private string ActivityEmptyMessage => status.State switch
    {
        "Processing" or "Scanning" => "The worker is starting up. The first scan and batch updates will appear here as soon as they are published.",
        "Degraded" => "The pipeline needs attention, so there are no fresh timeline entries yet. Check the warning details below while it recovers.",
        _ when status.TotalTracks == 0 => "Add music to the library, then AI enrichment activity will start showing up here.",
        _ when status.QueuedTracks > 0 => "AI enrichment is ready to run. Resume processing and the latest batches will appear here.",
        _ => "No recent AI activity yet. Once the worker starts, progress updates will appear here."
    };

    protected override async Task OnInitializedAsync()
    {
        await RefreshStatus();

        // Auto-refresh every 5 seconds while processing
        refreshTimer = new System.Threading.Timer(async _ =>
        {
            await RefreshStatus();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task RefreshStatus()
    {
        try
        {
            isLoading = true;
            status = await svc.GetAiStatusAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading AI status");
            status = new AiLibraryStatus();
        }
        finally
        {
            isLoading = false;
            hasLoaded = true;
        }
    }

    private async Task ResumeProcessing()
    {
        try
        {
            await svc.ResumeAiProcessingAsync();
            Logger.LogInformation("Resumed AI processing");
            await RefreshStatus();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error resuming AI processing");
        }
    }

    private string FormatDateTime(DateTime dateTime)
    {
        var local = dateTime.ToLocalTime();
        var diff = DateTime.UtcNow - dateTime.ToUniversalTime();
        
        if (diff.TotalMinutes < 1) return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 2) return "yesterday";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays} days ago";
        
        return local.ToString("MMM d, yyyy 'at' h:mm tt");
    }

    private string FormatActivityTimestamp(DateTime dateTime)
    {
        var local = dateTime.ToLocalTime();
        return $"{local:h:mm tt} · {FormatDateTime(dateTime)}";
    }

    private static string GetActivityItemClass(AiStatusActivity activity)
    {
        var tone = activity.Kind switch
        {
            "track-failed" or "batch-failed" or "degraded" => "danger",
            "batch-completed" => "success",
            "retry" => "info",
            "scan-progress" or "scan-completed" or "progress" or "batch-started" => "active",
            _ => "neutral"
        };

        return $"glass-ai-activity-item glass-ai-activity-item--{tone}";
    }

    private static string GetActivityIcon(AiStatusActivity activity) => activity.Kind switch
    {
        "track-failed" or "batch-failed" or "degraded" => "fas fa-triangle-exclamation",
        "batch-completed" => "fas fa-check",
        "retry" => "fas fa-rotate-right",
        "scan-progress" => "fas fa-magnifying-glass",
        "scan-completed" => "fas fa-binoculars",
        "batch-started" or "progress" => "fas fa-spinner fa-pulse",
        _ => "fas fa-wave-square"
    };

    private static string GetActivityLabel(AiStatusActivity activity) => activity.Kind switch
    {
        "track-failed" => "Track failure",
        "batch-failed" => "Batch ended with failures",
        "batch-completed" => "Batch completed",
        "batch-started" => "Batch started",
        "retry" => "Retry",
        "scan-progress" => "Scanning",
        "scan-completed" => "Scan finished",
        "progress" => "Pipeline status",
        "degraded" => "Needs attention",
        _ => "Activity"
    };

    private static string ShortBatchId(string? batchId)
    {
        if (string.IsNullOrWhiteSpace(batchId))
        {
            return string.Empty;
        }

        return batchId.Length <= 8 ? batchId : batchId[..8];
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }
}
