@page "/youtube"
@inject ILogger<YouTube> logger
@inject HomeSpeakerService svc
@inject YouTubeStateService state

<PageTitle>Home Speaker | YouTube</PageTitle>

<div class="glass-page glass-page--youtube">
    <div class="glass-page-header">
        <h1 class="glass-title">YouTube Cache</h1>
    </div>

    @if (ffmpegAvailable == false)
    {
        <div class="glass-alert glass-alert--danger" role="alert">
            <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
            <div><strong>ffmpeg not found.</strong> Downloading videos is disabled. Please install ffmpeg and ensure it is accessible at the configured path.</div>
        </div>
    }

    <form method="dialog" class="glass-search-row">
        <input type="text" class="glass-input" placeholder="Search YouTube..." aria-label="Search YouTube" @bind=state.SearchTerm />
        @if (isSearching)
        {
            <div class="glass-spinner" role="status" aria-label="Searching"></div>
        }
        else
        {
            <button class="glass-btn" type="submit" @onclick=searchAsync aria-label="Search">
                <i class="fas fa-search" aria-hidden="true"></i>
                <span class="glass-btn-label">Search</span>
            </button>
        }
    </form>

    @if (state.Videos == null)
    {
        <div class="glass-empty">
            <i class="fab fa-youtube" aria-hidden="true"></i>
            Search for something to create a temporary fair-use local cache.
        </div>
    }
    else
    {
        <div class="glass-list">
            @foreach (var searchResult in state.Videos)
            {
                <YouTubeSearchResult SearchResult="searchResult" FfmpegAvailable="ffmpegAvailable ?? true" />
            }
        </div>
    }
</div>

@code {
    bool isSearching = false;
    bool? ffmpegAvailable;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ffmpegAvailable = await svc.IsFfmpegAvailableAsync();
        }
        catch (Exception ex)
        {
            logger.LogWarning(ex, "Could not determine ffmpeg availability");
            ffmpegAvailable = false;
        }
    }

    async Task searchAsync()
    {
        if (string.IsNullOrWhiteSpace(state.SearchTerm))
            return;

        isSearching = true;
        logger.LogInformation("Starting youtube search for {SearchTerm}", state.SearchTerm);
        var results = (await svc.SearchVideosAsync(state.SearchTerm)).ToList();
        state.Videos = results;
        logger.LogInformation("Found {ResultCount} results", results.Count);
        isSearching = false;
    }
}
