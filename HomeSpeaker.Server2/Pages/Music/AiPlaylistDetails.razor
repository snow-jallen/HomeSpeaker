@page "/ai-playlists/{GenreKey}"
@inject HomeSpeakerService svc
@inject ILogger<AiPlaylistDetails> Logger
@attribute [StreamRendering]

<PageTitle>@(playlist?.DisplayName is { Length: > 0 } name ? $"{name} · AI Playlist" : "AI Playlist Details")</PageTitle>

<div class="glass-page glass-page--ai">
    <div class="glass-page-header">
        <a href="/ai-playlists" class="glass-btn glass-btn--ghost">
            <i class="fas fa-arrow-left" aria-hidden="true"></i>Back to playlists
        </a>
    </div>

    @if (!hasLoaded && isLoading)
    {
        <div class="glass-empty" role="status">
            <div class="glass-spinner" aria-hidden="true"></div>
            <span class="visually-hidden">Loading AI playlist details...</span>
        </div>
    }
    else if (playlist is null)
    {
        <section class="glass-empty">
            <i class="fas fa-brain" aria-hidden="true"></i>
            <div class="glass-row-title">Playlist not found</div>
            <p class="mb-0">That AI playlist is unavailable right now. Try going back to the playlist gallery and refreshing.</p>
        </section>
    }
    else
    {
        var currentPlaylist = playlist;
        <section class="glass-ai-panel">
            <div class="glass-section-title">AI playlist preview</div>
            <h1 class="glass-title">@currentPlaylist!.DisplayName</h1>
            <p class="glass-ai-lede">@currentPlaylist.Description</p>

            <div class="glass-ai-stats glass-ai-stats--compact">
                <div class="glass-ai-stat">
                    <span class="glass-ai-stat-label">Included tracks</span>
                    <span class="glass-ai-stat-value">@currentPlaylist.Tracks.Count</span>
                </div>
                <div class="glass-ai-stat">
                    <span class="glass-ai-stat-label">Genre key</span>
                    <span class="glass-ai-stat-value glass-ai-stat-value--text">@currentPlaylist.GenreKey</span>
                </div>
                <div class="glass-ai-stat">
                    <span class="glass-ai-stat-label">Scoring columns</span>
                    <span class="glass-ai-stat-value">@VisibleScoreColumnCount</span>
                </div>
            </div>

            <div class="glass-ai-play-row">
                <button type="button" @onclick="PlayPlaylist"
                        class="glass-btn"
                        disabled="@(playlist is null || IsPlaybackStarting)">
                    @if (isStartingPlaylist)
                    {
                        <span class="glass-spinner glass-spinner--inline" role="status" aria-hidden="true"></span>
                        <span>Starting full playlist…</span>
                    }
                    else
                    {
                        <i class="fas fa-play" aria-hidden="true"></i>
                        <span>Play all tracks</span>
                    }
                </button>
                <p class="glass-hint">Start the full AI playlist, or jump into any individual track from the ranked list below.</p>
            </div>
        </section>

        <section class="glass-page glass-ai-tracks">
            <div>
                <div class="glass-section-title">Why these tracks made it in</div>
                <h2 class="glass-ai-h2">Included tracks and AI scores</h2>
                <p class="glass-hint">Review the real playlist scoring data before pressing play. Marker columns only appear when the AI model exposed them for this playlist.</p>
            </div>

            @if (currentPlaylist!.Tracks.Count == 0)
            {
                <div class="glass-empty">
                    <i class="fas fa-table-list" aria-hidden="true"></i>
                    <p class="mb-0">No ranked tracks are available for this playlist yet.</p>
                </div>
            }
            else
            {
                <div class="glass-list">
                    @foreach (var track in currentPlaylist.Tracks)
                    {
                        <div class="glass-row glass-ai-track">
                            <button type="button" @onclick="() => PlayTrack(track)"
                                    class="hs-icon-btn hs-icon-btn--filled"
                                    title="Play @track.Song.Name"
                                    aria-label="Play @track.Song.Name by @track.Song.Artist"
                                    disabled="@IsPlaybackStarting">
                                @if (playingTrackSongId == track.Song.SongId)
                                {
                                    <span class="glass-spinner glass-spinner--inline" role="status" aria-hidden="true"></span>
                                    <span class="visually-hidden">Starting @track.Song.Name</span>
                                }
                                else
                                {
                                    <i class="fas fa-play" aria-hidden="true"></i>
                                }
                            </button>
                            <span class="glass-row-index">#@track.GenreRank</span>
                            <div class="glass-row-text">
                                <div class="glass-row-title">@track.Song.Name</div>
                                <div class="glass-row-sub">@string.Join(" · ", new[] { track.Song.Artist, track.Song.Album }.Where(part => !string.IsNullOrWhiteSpace(part)))</div>
                                @if (MarkerKeys.Count > 0)
                                {
                                    <div class="glass-ai-markers">
                                        @foreach (var markerKey in MarkerKeys)
                                        {
                                            var marker = track.Markers.FirstOrDefault(item => string.Equals(item.Key, markerKey, StringComparison.OrdinalIgnoreCase));
                                            if (marker is not null)
                                            {
                                                <span class="glass-ai-marker">
                                                    <span class="glass-ai-marker-key">@FormatMarkerLabel(markerKey)</span>
                                                    <strong>@marker.Value.ToString("0.###")</strong>
                                                    <span class="glass-ai-marker-conf">Conf. @marker.Confidence.ToString("0.##")</span>
                                                </span>
                                            }
                                        }
                                    </div>
                                }
                                @if (HasWhyColumn && !string.IsNullOrWhiteSpace(track.Why))
                                {
                                    <div class="glass-ai-why"><span class="glass-ai-marker-key">Why</span> @track.Why</div>
                                }
                            </div>
                            <div class="glass-ai-score">
                                <span class="glass-ai-score-value">@track.GenreScore.ToString("0.###")</span>
                                <span class="glass-ai-score-label">Genre score</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    }
</div>

@code {
    [Parameter]
    public string GenreKey { get; set; } = string.Empty;

    private AiPlaylist? playlist;
    private bool isLoading = true;
    private bool hasLoaded;
    private bool isStartingPlaylist;
    private int? playingTrackSongId;

    private IReadOnlyList<string> MarkerKeys =>
        playlist?.Tracks
            .SelectMany(track => track.Markers)
            .Select(marker => marker.Key)
            .Where(key => !string.IsNullOrWhiteSpace(key))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(key => key, StringComparer.OrdinalIgnoreCase)
            .ToList() ?? (IReadOnlyList<string>)Array.Empty<string>();

    private int VisibleScoreColumnCount => 2 + MarkerKeys.Count + (HasWhyColumn ? 1 : 0);

    private bool HasWhyColumn => playlist?.Tracks.Any(track => !string.IsNullOrWhiteSpace(track.Why)) == true;
    private bool IsPlaybackStarting => isStartingPlaylist || playingTrackSongId.HasValue;

    protected override async Task OnParametersSetAsync()
    {
        await LoadPlaylistAsync();
    }

    private async Task LoadPlaylistAsync()
    {
        try
        {
            isLoading = true;
            playlist = await svc.GetAiPlaylistAsync(GenreKey);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading AI playlist details for {GenreKey}", GenreKey);
            playlist = null;
        }
        finally
        {
            isLoading = false;
            hasLoaded = true;
        }
    }

    private async Task PlayPlaylist()
    {
        if (playlist is null || string.IsNullOrWhiteSpace(GenreKey))
        {
            return;
        }

        try
        {
            isStartingPlaylist = true;
            await svc.PlayAiPlaylistAsync(GenreKey);
            Logger.LogInformation("Started AI playlist from details page: {GenreKey}", GenreKey);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error playing AI playlist from details page: {GenreKey}", GenreKey);
        }
        finally
        {
            isStartingPlaylist = false;
        }
    }

    private async Task PlayTrack(AiPlaylistTrack track)
    {
        if (playlist is null || string.IsNullOrWhiteSpace(GenreKey) || track.Song.SongId <= 0)
        {
            return;
        }

        try
        {
            playingTrackSongId = track.Song.SongId;
            await svc.PlayAiPlaylistTrackAsync(GenreKey, track.Song.SongId);
            Logger.LogInformation("Started AI playlist track from details page: {GenreKey} {SongId}", GenreKey, track.Song.SongId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error playing AI playlist track from details page: {GenreKey} {SongId}", GenreKey, track.Song.SongId);
        }
        finally
        {
            playingTrackSongId = null;
        }
    }

    private static string FormatMarkerLabel(string markerKey)
    {
        return string.Join(' ',
            markerKey
                .Replace("-", " ", StringComparison.Ordinal)
                .Replace("_", " ", StringComparison.Ordinal)
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Select(part => char.ToUpperInvariant(part[0]) + part[1..]));
    }
}
