@using System.Globalization
@inject DashboardState Dashboard
@inject TimeProvider Time
@implements IDisposable
@* The Home page's climate card: outside, the window advice, the outlook and the indoor rooms. Compact drops the outlook. *@

@{
    var advice = WindowAdvice.From(Dashboard.Temperature, Dashboard.TemperatureUnit);
    var outside = ClimateRoom.Outside(Dashboard.Temperature, Time.GetUtcNow().UtcDateTime);
    var outsideLow = outside?.LowBattery == true;
    var indoorRooms = ClimateRoom.From(Dashboard.Temperature, Time.GetUtcNow().UtcDateTime);
}
<a class="glass hs-info-card hs-climate @(Compact ? "is-compact" : "")" href="climate">
    <div class="hs-card-head">
        <span class="hs-card-label">
            <span class="hs-card-label-text">Climate</span>
            @if (ClimateRoom.AnySensorLow(Dashboard.Temperature))
            {
                <LowBatteryIcon Label="A temperature sensor battery is low" />
            }
        </span>
        @if (advice is not null)
        {
            <span class="hs-climate-advice @(advice.Close ? "is-close" : "is-open")">@advice.Text</span>
        }
    </div>
    <div class="hs-climate-top">
        <div class="hs-climate-outside">
            <span class="hs-climate-big">@(TemperatureDisplay.Format(outside?.Temperature, Dashboard.TemperatureUnit))</span>
            @if (outsideLow)
            {
                <LowBatteryIcon Label="Outside sensor battery is low" />
            }
            <span class="hs-climate-detail">
                <span>Outside@(conditions is null ? "" : " · " + conditions)</span>
                @if (outside?.Note is { } outsideNote)
                {
                    <span class="hs-room-age">@outsideNote</span>
                }
                @if (highLow is not null)
                {
                    <span>@highLow</span>
                }
            </span>
        </div>
        @if (!Compact && outlook.Count > 0)
        {
            <div class="hs-climate-outlook">
                @foreach (var line in outlook)
                {
                    <span>@line</span>
                }
            </div>
        }
    </div>
    @if (indoorRooms.Count > 0)
    {
        <div class="hs-rooms">
            @foreach (var room in indoorRooms)
            {
                <span class="hs-room @(room.Note is null ? "" : room.Temperature is null ? "is-silent" : "is-aging")">
                    <span class="hs-room-name">@room.Label</span>
                    <span class="hs-room-temp">
                        @if (room.Temperature is not null)
                        {
                            @TemperatureDisplay.Format(room.Temperature, Dashboard.TemperatureUnit)
                        }
                        else
                        {
                            <span class="hs-room-age">@room.Note</span>
                        }
                        @if (room.LowBattery)
                        {
                            <LowBatteryIcon Label="@(room.Label + " sensor battery is low")" />
                        }
                    </span>
                    @if (room.Temperature is not null && room.Note is not null)
                    {
                        <span class="hs-room-age">@room.Note</span>
                    }
                </span>
            }
        </div>
    }
</a>

@code {
    [Parameter]
    public bool Compact { get; set; }

    private string? highLow =>
        Dashboard.ForecastEnabled && Dashboard.Forecast is { Error: null, TodayHigh.Temperature: { } high, TonightLow.Temperature: { } low }
            ? $"H {TemperatureDisplay.Format(high, Dashboard.TemperatureUnit)} · L {TemperatureDisplay.Format(low, Dashboard.TemperatureUnit)}"
            : null;

    private string? conditions => Dashboard.ForecastEnabled && Dashboard.Forecast is { Error: null } ? Dashboard.Forecast.TodayHigh?.Conditions : null;

    // Rain chance today and tomorrow's high, each only when the forecast has it.
    private IReadOnlyList<string> outlook
    {
        get
        {
            var lines = new List<string>();
            if (Dashboard.ForecastEnabled && Dashboard.Forecast is { Error: null } forecast)
            {
                if (forecast.TodayHigh?.PrecipitationChance is { } rain)
                {
                    lines.Add(string.Create(CultureInfo.InvariantCulture, $"Rain {rain:0}%"));
                }

                if (forecast.TomorrowHigh is { Temperature: { } tomorrow } next)
                {
                    lines.Add($"Tomorrow {TemperatureDisplay.Format(tomorrow, Dashboard.TemperatureUnit)}" + (string.IsNullOrEmpty(next.Conditions) ? "" : " · " + next.Conditions));
                }
            }

            return lines;
        }
    }

    protected override void OnInitialized() => Dashboard.Changed += onChanged;

    private void onChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Dashboard.Changed -= onChanged;
}
