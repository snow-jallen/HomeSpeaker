@using HomeSpeaker.Server2.Services.Dashboard

<svg class="hs-wx-icon" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="@Label">
    <title>@Label</title>
    @switch (Icon)
    {
        case WeatherIcon.Clear when IsDay:
            <g class="hs-wx-sun">
                <circle cx="12" cy="12" r="4.2"></circle>
                <path d="M12 2.5v2.3M12 19.2v2.3M2.5 12h2.3M19.2 12h2.3M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"></path>
            </g>
            break;
        case WeatherIcon.Clear:
            <path class="hs-wx-moon" d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7z"></path>
            break;
        case WeatherIcon.PartlyCloudy when IsDay:
            <g class="hs-wx-sun">
                <circle cx="8" cy="8" r="3"></circle>
                <path d="M8 1.8v1.4M1.8 8h1.4M3.6 3.6l1 1M12.4 3.6l-1 1"></path>
            </g>
            <path d="M9 20h8.5a3.8 3.8 0 0 0 .4-7.6A5.2 5.2 0 0 0 8 13.6 3.2 3.2 0 0 0 9 20z"></path>
            break;
        case WeatherIcon.PartlyCloudy:
            <path class="hs-wx-moon" d="M10.5 3.6a5.2 5.2 0 1 0 5.9 6.6 4.2 4.2 0 0 1-5.9-6.6z"></path>
            <path d="M9 20h8.5a3.8 3.8 0 0 0 .4-7.6A5.2 5.2 0 0 0 8 13.6 3.2 3.2 0 0 0 9 20z"></path>
            break;
        case WeatherIcon.Cloudy:
            <path d="M7 19h10.5a4.2 4.2 0 0 0 .5-8.4A6 6 0 0 0 6.4 11.8 3.7 3.7 0 0 0 7 19z"></path>
            break;
        case WeatherIcon.Fog:
            <path d="M7 14h10.5a3.6 3.6 0 0 0 .4-7.2A5.2 5.2 0 0 0 7.5 7.8 3.2 3.2 0 0 0 7 14z"></path>
            <path d="M4 17.5h16M7 21h10"></path>
            break;
        case WeatherIcon.Drizzle:
            <path d="M7 14h10.5a3.6 3.6 0 0 0 .4-7.2A5.2 5.2 0 0 0 7.5 7.8 3.2 3.2 0 0 0 7 14z"></path>
            <path d="M8 17.5v1.5M12 18.5v1.5M16 17.5v1.5"></path>
            break;
        case WeatherIcon.Rain:
            <path d="M7 14h10.5a3.6 3.6 0 0 0 .4-7.2A5.2 5.2 0 0 0 7.5 7.8 3.2 3.2 0 0 0 7 14z"></path>
            <path d="M8.5 17l-1 3.5M12.5 17l-1 3.5M16.5 17l-1 3.5"></path>
            break;
        case WeatherIcon.Snow:
            <path d="M7 14h10.5a3.6 3.6 0 0 0 .4-7.2A5.2 5.2 0 0 0 7.5 7.8 3.2 3.2 0 0 0 7 14z"></path>
            <path d="M8 18.5h.01M12 20.5h.01M16 18.5h.01" stroke-width="2.6"></path>
            break;
        case WeatherIcon.Thunderstorm:
            <path d="M7 14h10.5a3.6 3.6 0 0 0 .4-7.2A5.2 5.2 0 0 0 7.5 7.8 3.2 3.2 0 0 0 7 14z"></path>
            <path class="hs-wx-bolt" d="M12.8 14.5l-3 4h3.4l-1.8 4"></path>
            break;
    }
</svg>

@code {
    [Parameter]
    public WeatherIcon Icon { get; set; }

    [Parameter]
    public bool IsDay { get; set; } = true;

    [Parameter]
    public int Size { get; set; } = 28;

    /// <summary>The conditions text, used as the accessible name.</summary>
    [Parameter]
    public string Label { get; set; } = "";
}
