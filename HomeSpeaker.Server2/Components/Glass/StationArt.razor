@* A radio station's artwork: its uploaded image, shown whole (contain) on the tile's gradient so wide logos keep
   their sides while square art still fills the tile. The generated tile (gradient + initials) shows whenever
   there is no image or the image fails to load. Size and radius come from Class. *@
@{
    var tile = StationTile.For(Name);
    var fontSize = tile.Initials.Length switch { > 2 => 32, 2 => 40, _ => 50 };
}
<div class="hs-station-art @Class"
     style="--hs-tile-bg:@tile.Background;background:@tile.Background"
     role="@(Label is null ? null : "img")"
     aria-label="@Label"
     aria-hidden="@(Label is null ? "true" : null)">
    <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false">
        <text x="50" y="50" text-anchor="middle" dominant-baseline="central" font-size="@fontSize">@tile.Initials</text>
    </svg>
    @if (!string.IsNullOrWhiteSpace(ImageUrl))
    {
        @* Keyed on the URL so a new image gets a fresh element rather than inheriting a hidden one. *@
        <img @key="ImageUrl" src="@ImageUrl" alt="" onerror="this.style.display='none'" />
    }
</div>

@code {
    /// <summary>The station name; drives the generated tile's colour and initials.</summary>
    [Parameter] public string? Name { get; set; }

    /// <summary>The uploaded station image, if any (e.g. /favicons/kbaq.png or a data: URI).</summary>
    [Parameter] public string? ImageUrl { get; set; }

    /// <summary>Size classes such as glass-row-art, hs-art or hs-art hs-art--lg.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Accessible name; when null the art is decorative and hidden from assistive tech.</summary>
    [Parameter] public string? Label { get; set; }
}
