@using System.Globalization
@using HomeSpeaker.Shared.BloodSugar
@inject DashboardState Dashboard
@inject TimeProvider Time
@implements IDisposable

<div class="hs-ambient-overlay" data-layout="default">
    <div class="hs-ov-clock">
        <Clock Format="h:mm" Class="hs-ov-time" />
        <Clock Format="dddd, MMMM d" Class="hs-ov-date" />
    </div>

    <div class="hs-ov-chips">
        @if (Dashboard.BloodSugarEnabled && Dashboard.BloodSugar?.CurrentReading is { } reading)
        {
            @* No drop icon: the panel's green/yellow/red color marks it, and the space goes to the number. *@
            var sinceReading = readingAge(reading);
            var sgv = reading.Sgv.ToString("0", CultureInfo.InvariantCulture);
            if (sinceReading >= OldAfter)
            {
                @* Old data: how long it's been is the news, so it takes the panel, colored by age rather than by the
                   reading (an old good number is still bad news); past an hour it grows and pulses. *@
                <div class="glass hs-chip hs-chip-glucose hs-chip-glucose--aged @(sinceReading >= MissingAfter ? "is-missing" : "") hs-age-@ageLevel(sinceReading)">
                    <span class="hs-chip-age">@longAge(sinceReading)</span>
                    <span class="hs-chip-meta"><span>last @sgv @reading.DirectionIcon</span><span>mg/dL</span></span>
                </div>
            }
            else
            {
                <div class="glass hs-chip hs-chip-glucose hs-tone-@toneClass">
                    <span class="hs-chip-value @(Dashboard.BloodSugar.IsStale ? "is-stale" : "")">@sgv</span>
                    <span class="hs-chip-arrow" title="@reading.DirectionDescription">@reading.DirectionIcon</span>
                    <span class="hs-chip-meta"><span>mg/dL</span><span>@age(sinceReading)</span></span>
                </div>
            }
        }
        @if (Dashboard.TemperatureEnabled && Dashboard.Temperature?.OutsideTemperature is { } outside)
        {
            <div class="glass hs-chip">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#ffd27a" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
                <span class="hs-chip-value">@TemperatureDisplay.Format(outside, Dashboard.TemperatureUnit)</span>
                <span class="hs-chip-meta">
                    @if (highLow is not null)
                    {
                        <span>@highLow</span>
                    }
                    @if (conditions is not null)
                    {
                        <span>@conditions</span>
                    }
                </span>
            </div>
        }
    </div>

    @if (NowPlayingInfo.From(Dashboard.Status) is { } np)
    {
        <div class="glass hs-ov-playing">
            @if (np.SongId is { } songId)
            {
                <div class="hs-art" style="background-image:url('/api/homespeaker/songs/@songId/art')"></div>
            }
            else
            {
                <StationArt Name="@np.Station" ImageUrl="@Dashboard.StationImageUrl" Class="hs-art" />
            }
            <div class="hs-ov-playing-text">
                <div class="hs-ov-title">@np.Title</div>
                @if (np.Subtitle is not null)
                {
                    <div class="hs-ov-sub">@np.Subtitle</div>
                }
                @if (!np.IsStream)
                {
                    <div class="hs-progress"><div style="width:@((np.Percent * 100).ToString("F1", CultureInfo.InvariantCulture))%"></div></div>
                }
            </div>
        </div>
    }

    @* Filled in by ambientSlideshow.js; Blazor never binds these, so it never overwrites them. *@
    <div class="hs-ov-caption"><div class="hs-caption-place"></div><div class="hs-caption-when"></div></div>
</div>

@code {
    // Past these the reading's age becomes the headline, then grows and pulses.
    private static readonly TimeSpan OldAfter = TimeSpan.FromMinutes(30);
    private static readonly TimeSpan MissingAfter = TimeSpan.FromMinutes(60);

    private string toneClass => Dashboard.GlucoseTone switch
    {
        GlucoseTone.Caution => "caution",
        GlucoseTone.Urgent => "urgent",
        _ => "normal",
    };

    private string? highLow =>
        Dashboard.ForecastEnabled && Dashboard.Forecast is { Error: null, TodayHigh.Temperature: { } high, TonightLow.Temperature: { } low }
            ? $"H {TemperatureDisplay.Format(high, Dashboard.TemperatureUnit)} · L {TemperatureDisplay.Format(low, Dashboard.TemperatureUnit)}"
            : null;

    private string? conditions => Dashboard.ForecastEnabled && Dashboard.Forecast is { Error: null } ? Dashboard.Forecast.TodayHigh?.Conditions : null;

    protected override void OnInitialized() => Dashboard.Changed += onChanged;

    private void onChanged() => _ = InvokeAsync(StateHasChanged);

    // Hours past the first hour, so an old reading can't widen the fixed-size panel.
    private static string age(TimeSpan sinceReading) => sinceReading.TotalMinutes switch
    {
        < 1 => "just now",
        < 60 => string.Create(CultureInfo.InvariantCulture, $"{(int)sinceReading.TotalMinutes} min ago"),
        _ => string.Create(CultureInfo.InvariantCulture, $"{(int)sinceReading.TotalHours} hr ago"),
    };

    // 1 at 30 min, 2 at 45, 3 at an hour, 4 at two hours: amber through deep red.
    private static int ageLevel(TimeSpan sinceReading) => sinceReading.TotalMinutes switch
    {
        < 45 => 1,
        < 60 => 2,
        < 120 => 3,
        _ => 4,
    };

    // Measured now rather than at fetch time; the overlay re-renders every few seconds.
    private TimeSpan readingAge(BloodSugarReading reading)
    {
        var since = Time.GetUtcNow().UtcDateTime - reading.Date.ToUniversalTime();
        return since < TimeSpan.Zero ? TimeSpan.Zero : since;
    }

    // "42 min", "1h 15m", and whole hours past ten so the headline stays inside the panel.
    private static string longAge(TimeSpan sinceReading)
    {
        var minutes = (int)sinceReading.TotalMinutes;
        return minutes switch
        {
            < 60 => string.Create(CultureInfo.InvariantCulture, $"{minutes} min"),
            < 600 => string.Create(CultureInfo.InvariantCulture, $"{minutes / 60}h {minutes % 60}m"),
            _ => string.Create(CultureInfo.InvariantCulture, $"{minutes / 60} hr"),
        };
    }

    public void Dispose() => Dashboard.Changed -= onChanged;
}
