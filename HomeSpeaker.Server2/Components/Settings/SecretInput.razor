@using HomeSpeaker.Server2.Settings

@* Write-only: a saved secret never reaches the browser. Typing replaces it; Remove clears it on save. *@
<label class="glass-field">
    <span>@Editor.Field(Key).Label</span>
    <div class="glass-input-group">
        <input class="glass-input" type="password" autocomplete="new-password" placeholder="@placeholder"
               value="@typed" @onchange="onChange" disabled="@Editor.IsOverridden(Key)" />
        @if (isSaved && !Editor.IsOverridden(Key))
        {
            <button type="button" class="glass-btn glass-btn--ghost" @onclick="remove">Remove</button>
        }
    </div>
    <SettingNote Editor="Editor" Key="@Key" Hint="@hint" />
</label>

@code {
    [Parameter, EditorRequired] public SettingsEditor Editor { get; set; } = default!;
    [Parameter, EditorRequired] public string Key { get; set; } = "";

    private bool isSaved => Editor.Field(Key).Value == SettingsForm.MaskedValue;
    private bool isMasked => Editor[Key] == SettingsForm.MaskedValue;
    private string typed => isMasked || Editor[Key] is null ? "" : Editor[Key]!;
    private string placeholder => isMasked ? "Saved (type to replace)" : "Not set";
    private string? hint => isSaved && string.IsNullOrEmpty(Editor[Key]) ? "Will be removed when you save." : null;

    private void onChange(ChangeEventArgs e)
    {
        var text = e.Value?.ToString();
        // Clearing the box after typing goes back to the saved secret, not to "remove".
        Editor[Key] = string.IsNullOrEmpty(text) && isSaved ? SettingsForm.MaskedValue : text;
    }

    private void remove() => Editor[Key] = "";
}
