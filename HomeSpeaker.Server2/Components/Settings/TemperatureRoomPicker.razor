@using HomeSpeaker.Server2.Settings
@using HomeSpeaker.Server2.Services.BleTemperature
@inject IServiceScopeFactory ScopeFactory
@inject IConfiguration Config
@inject TimeProvider Time

<div class="hs-settings-rooms">
    <h3 class="glass-section-title">Rooms</h3>
    @if (!Bluetooth && string.IsNullOrEmpty(Config[SettingKeys.TemperatureApiKey]))
    {
        <p class="glass-hint">Save a Govee API key, then come back to name the rooms.</p>
    }
    else if (Bluetooth && !string.IsNullOrWhiteSpace(Editor[SettingKeys.TemperatureHubUrl]))
    {
        <p class="glass-hint">Rooms are named on the hub speaker. This one sends what it hears there and shows the hub's rooms.</p>
    }
    else if (loading)
    {
        <div class="glass-spinner glass-spinner--inline" role="status" aria-label="Loading sensors"></div>
    }
    else if (rows.Count == 0)
    {
        <p class="glass-hint">@(Bluetooth
            ? "No Bluetooth sensors heard yet. Save, restart, and give the speakers a minute or two to scan."
            : "No Govee sensors found. Check the API key, save, and restart.")</p>
    }
    else
    {
        @if (readOnly)
        {
            <p class="hs-settings-note"><i class="fas fa-lock" aria-hidden="true"></i> Rooms are set by an environment variable; change them there.</p>
        }
        else if (!representable)
        {
            <p class="glass-alert glass-alert--warning" role="note">Rooms are set with matching rules; editing here replaces them</p>
        }
        <p class="glass-hint">Name a room to show it; leave it blank to hide the sensor. Pick the one outside for window advice.</p>
        <ol class="hs-settings-room-list">
            @for (var i = 0; i < rows.Count; i++)
            {
                var index = i;
                var row = rows[index];
                <li class="hs-settings-room">
                    <span class="hs-settings-room-device" title="@(Bluetooth ? "Bluetooth sensor " + row.DeviceName : "Govee device")">
                        @label(row.DeviceName)
                        @if (details.GetValueOrDefault(row.DeviceName) is { } detail)
                        {
                            <small class="hs-settings-room-detail">@detail</small>
                        }
                    </span>
                    <input class="glass-input" type="text" placeholder="Hidden" aria-label="@($"Room for {row.DeviceName}")"
                           value="@row.Room" @onchange="e => setRoom(index, e.Value?.ToString())" disabled="@readOnly" />
                    <label class="hs-settings-radio">
                        <input type="radio" name="hs-outside-room" checked="@row.IsOutside" @onchange="() => setOutside(index)"
                               disabled="@(readOnly || string.IsNullOrWhiteSpace(row.Room))" />
                        Outside
                    </label>
                    <span class="hs-settings-order">
                        <button type="button" class="hs-icon-btn" aria-label="@($"Move {row.DeviceName} up")" @onclick="() => move(index, -1)" disabled="@(readOnly || index == 0)">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                        <button type="button" class="hs-icon-btn" aria-label="@($"Move {row.DeviceName} down")" @onclick="() => move(index, 1)" disabled="@(readOnly || index == rows.Count - 1)">
                            <i class="fas fa-chevron-down" aria-hidden="true"></i>
                        </button>
                    </span>
                </li>
            }
        </ol>
        <SettingNote Editor="Editor" Key="@roomsKey" />
    }
</div>

@code {
    [Parameter, EditorRequired] public SettingsEditor Editor { get; set; } = default!;

    private List<RoomAssignment> rows = [];
    private bool loading = true;
    private bool representable = true;

    /// <summary>Bluetooth sensors (rooms by address, <c>Temperature:BluetoothRooms</c>) instead of Govee cloud devices.</summary>
    [Parameter] public bool Bluetooth { get; set; }

    private string roomsKey => Bluetooth ? SettingKeys.TemperatureBluetoothRooms : SettingKeys.TemperatureRooms;

    private bool readOnly => Editor.IsOverridden(roomsKey) || Editor.IsOverridden(SettingKeys.TemperatureOutsideRoom);

    private bool? loadedFor;

    // Bluetooth address -> the advertised name, and a second line with the address and when it was last heard.
    private Dictionary<string, string> labels = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, string> details = new(StringComparer.OrdinalIgnoreCase);

    private string label(string deviceName) => labels.GetValueOrDefault(deviceName, deviceName);

    // Loads once a key is saved (or the source changes), which may happen while the page is open.
    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == Bluetooth || (!Bluetooth && string.IsNullOrEmpty(Config[SettingKeys.TemperatureApiKey])))
        {
            loading = false;
            return;
        }

        loadedFor = Bluetooth;
        loading = true;
        await using var scope = ScopeFactory.CreateAsyncScope();
        List<string> names;
        if (Bluetooth)
        {
            var store = scope.ServiceProvider.GetRequiredService<SensorReadingStore>();
            var now = Time.GetUtcNow().UtcDateTime;
            var heard = store.All;
            labels = heard.ToDictionary(s => s.Mac, s => s.Name, StringComparer.OrdinalIgnoreCase);
            details = heard.ToDictionary(
                s => s.Mac,
                s => $"{s.Mac} · {ReadingAge.Of(s.ObservedAt, now).Note ?? "heard just now"}",
                StringComparer.OrdinalIgnoreCase);

            // Sensors already given a room but not heard lately stay listed, so editing another row keeps them.
            var mapped = TemperatureRoomConfig.Parse(Editor[roomsKey]).SelectMany(r => r.Patterns).Select(p => p.Trim().ToUpperInvariant());
            names = [.. heard.Select(s => s.Mac).Concat(mapped.Where(m => !labels.ContainsKey(m))).Distinct(StringComparer.OrdinalIgnoreCase)];
            foreach (var missing in names.Where(n => !labels.ContainsKey(n)))
            {
                details[missing] = "not heard yet";
            }
        }
        else
        {
            // A fresh scope builds a TemperatureService from the current (possibly just saved) key.
            var devices = await scope.ServiceProvider.GetRequiredService<TemperatureService>().GetDevicesAsync();
            names = [.. devices.Select(d => d.DeviceName)];
            labels = new(StringComparer.OrdinalIgnoreCase);
            details = new(StringComparer.OrdinalIgnoreCase);
        }

        representable = RoomAssignments.IsRepresentable(Editor[roomsKey], names);
        rows = [.. RoomAssignments.FromRules(names, Editor[roomsKey], Editor[SettingKeys.TemperatureOutsideRoom])];
        loading = false;
    }

    private void setRoom(int index, string? room)
    {
        var row = rows[index];
        var blank = string.IsNullOrWhiteSpace(room);
        rows[index] = row with { Room = blank ? null : room!.Trim(), IsOutside = !blank && row.IsOutside };
        write();
    }

    private void setOutside(int index)
    {
        rows = [.. rows.Select((row, i) => row with { IsOutside = i == index })];
        write();
    }

    private void move(int index, int delta)
    {
        var target = index + delta;
        (rows[index], rows[target]) = (rows[target], rows[index]);
        write();
    }

    // Only an edit writes the rooms, so opening the page never replaces rules it can't show.
    private void write()
    {
        var named = rows.Where(r => r.Room is not null).Select(r => r.Room!).ToList();
        if (named.Any(r => r.IndexOfAny([';', ':', ',']) >= 0))
        {
            Editor.Errors[roomsKey] = "Room names can't contain ; : or ,";
            return;
        }

        if (named.Count != named.Distinct(StringComparer.OrdinalIgnoreCase).Count())
        {
            Editor.Errors[roomsKey] = "Each room needs a different name.";
            return;
        }

        var (roomsSetting, outside) = RoomAssignments.ToSettings(rows);
        Editor[roomsKey] = roomsSetting;
        Editor[SettingKeys.TemperatureOutsideRoom] = outside ?? "";
        Editor.Errors.Remove(SettingKeys.TemperatureIndoorRoom);
        representable = true;
    }
}
