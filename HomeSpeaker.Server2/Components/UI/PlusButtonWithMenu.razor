@using Microsoft.JSInterop
@inject IJSRuntime JsRuntime

<div class="position-relative d-inline-block" id="@menuAnchorId">
    <button @onclick="ToggleMenu" class="hs-icon-btn hs-icon-btn--filled" title="Add to queue or playlist" aria-label="Add to queue or playlist" aria-haspopup="menu" aria-expanded="@showMenu">
        <i class="fas fa-plus" aria-hidden="true"></i>
    </button>
    
    @if (showMenu)
    {
        <div class="dropdown-menu-container" style="position: absolute; @dropdownPositionStyle z-index: 10000;">
            <AddToQueueOrPlaylistModal Songs="Songs" Song="Song" OnClosed="CloseMenu" />
        </div>
    }
</div>

@* Click outside to close *@
@if (showMenu)
{
    <div class="position-fixed" style="top: 0; left: 0; width: 100%; height: 100vh; z-index: 9999;" @onclick="CloseMenu"></div>
}

@code {
    [Parameter] public List<SongViewModel>? Songs { get; set; }
    [Parameter] public SongViewModel? Song { get; set; }

    private bool showMenu = false;
    private readonly string menuAnchorId = $"mb{Guid.NewGuid():N}";
    private string dropdownPositionStyle = "top: 100%; right: 0;";

    private async void ToggleMenu()
    {
        showMenu = !showMenu;
        if (showMenu)
        {
            await UpdateDropdownPosition();
        }
        StateHasChanged();
    }

    private void CloseMenu()
    {
        showMenu = false;
        StateHasChanged();
    }    private async Task UpdateDropdownPosition()
    {
        try
        {
            // Use JavaScript to check positioning and return the appropriate style
            var positionStyle = await JsRuntime.InvokeAsync<string>("eval", $@"
                (function(element) {{
                    var rect = element.getBoundingClientRect();
                    var viewportWidth = window.innerWidth;
                    var dropdownWidth = 220; // Approximate width of dropdown
                    var dropdownHeight = 260; // Approximate height of dropdown
                    var main = element.closest('.hs-main');
                    var bottomLimit = main ? main.getBoundingClientRect().bottom : window.innerHeight;
                    var topLimit = main ? main.getBoundingClientRect().top : 0;
                    var horizontal = (rect.right + dropdownWidth > viewportWidth) ? 'right: 0;' : 'left: 0;';
                    var openUp = (rect.bottom + dropdownHeight > bottomLimit) && (rect.top - topLimit > bottomLimit - rect.bottom);
                    return (openUp ? 'bottom: 100%; ' : 'top: 100%; ') + horizontal;
                }})(document.getElementById('{menuAnchorId}'))");
            
            dropdownPositionStyle = positionStyle;
        }
        catch
        {
            // Fallback to default positioning if JS call fails
            dropdownPositionStyle = "top: 100%; right: 0;";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (showMenu)
        {
            // Add event listener for escape key to close menu
            await JsRuntime.InvokeVoidAsync("eval", @"
                document.addEventListener('keydown', function escapeHandler(e) {
                    if (e.key === 'Escape') {
                        document.removeEventListener('keydown', escapeHandler);
                        // Find and click the overlay to close the menu
                        const overlay = document.querySelector('.position-fixed[style*=""z-index: 9999""]');
                        if (overlay) overlay.click();
                    }
                });            ");
        }
    }
}
