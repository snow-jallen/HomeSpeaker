@inject HomeSpeakerService svc
<h2 class="glass-section-title">Folder List</h2>
@if (folders == null)
{
    <div class="glass-empty">Loading folders...</div>
}
else
{
    <div class="glass-list">
        @foreach (var folder in folders)
        {
            <Folder Name=@folder />
        }
    </div>
}

@code {
    IEnumerable<string>? folders;

    protected override async Task OnInitializedAsync()
    {
        folders = (await svc.GetFolders()).Order();
    }
}
