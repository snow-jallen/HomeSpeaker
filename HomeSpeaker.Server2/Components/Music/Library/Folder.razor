@inject HomeSpeakerService svc

<div class="glass-group">
    <div class="glass-row @(isExpanded ? "is-active" : "")">
        <button type="button" class="glass-row-toggle" @onclick=toggleExpanded aria-expanded="@(isExpanded ? "true" : "false")">
            <i class="fas @(isExpanded ? "fa-chevron-down" : "fa-chevron-right") glass-row-chevron" aria-hidden="true"></i>
            <span class="glass-row-text">
                <span class="glass-row-title">@(Name ?? "Folder Unknown")</span>
            </span>
        </button>
        <div class="glass-row-actions">
            <PlayButtonWithDropdown FolderName="@Name" />
            <PlusButtonWithMenu Songs="songs?.ToList()" />
        </div>
    </div>
    @if (isExpanded)
    {
        <div class="glass-group-body">
            <FolderDetails Name=@Name Songs="@songs" />
        </div>
    }
</div>

@code {
    protected override async Task OnParametersSetAsync()
    {
        songs = Name switch
        {
            null => Enumerable.Empty<SongViewModel>(),
            _ => await svc.GetSongsInFolder(Name)
        };
    }

    IEnumerable<SongViewModel>? songs;

    [Parameter]
    public string? Name { get; set; }    private bool isExpanded = false;

    void toggleExpanded() => isExpanded = !isExpanded;
}
