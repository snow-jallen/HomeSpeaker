<div class="glass-group">
    <div class="glass-row @(isExpanded ? "is-active" : "")">
        <button type="button" class="glass-row-toggle" @onclick=toggleExpanded aria-expanded="@(isExpanded ? "true" : "false")">
            <i class="fas @(isExpanded ? "fa-chevron-down" : "fa-chevron-right") glass-row-chevron" aria-hidden="true"></i>
            <span class="glass-row-text">
                <span class="glass-row-title">@(String.IsNullOrWhiteSpace(Content?.Key) ? "[ No Artist ]" : Content.Key)</span>
                <span class="glass-row-sub">@Content?.Count() songs</span>
            </span>
        </button>
        <div class="glass-row-actions">
            <PlayButtonWithDropdown Songs="Content?.ToList()" />
            <PlusButtonWithMenu Songs="Content?.ToList()" />
        </div>
    </div>

    @if (isExpanded)
    {
        <div class="glass-group-body">
            @foreach (var album in from song in Content ?? Enumerable.Empty<SongViewModel>()
                                  group song by song.Album into album
                                  select album)
            {
                var albumKey = album.Key ?? "";
                var albumExpanded = expandedAlbums.Contains(albumKey);
                <div class="glass-group">
                    <div class="glass-row glass-row--sub @(albumExpanded ? "is-active" : "")">
                        <button type="button" class="glass-row-toggle" @onclick="() => toggleAlbum(albumKey)" aria-expanded="@(albumExpanded ? "true" : "false")">
                            <i class="fas @(albumExpanded ? "fa-chevron-down" : "fa-chevron-right") glass-row-chevron" aria-hidden="true"></i>
                            <span class="glass-row-text">
                                <span class="glass-row-title">@(String.IsNullOrWhiteSpace(album.Key) ? "[ No Album ]" : album.Key)</span>
                                <span class="glass-row-sub">@album.Count() songs</span>
                            </span>
                        </button>
                        <div class="glass-row-actions">
                            <PlayButtonWithDropdown Songs="album.ToList()" />
                            <PlusButtonWithMenu Songs="album.ToList()" />
                        </div>
                    </div>
                    @if (albumExpanded)
                    {
                        <div class="glass-group-body">
                            <FolderDetails Name="@album.Key" Songs="@album" />
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>


@code {
    [Parameter]
    public IGrouping<string, SongViewModel>? Content { get; set; }

    private bool isExpanded = false;
    private HashSet<string> expandedAlbums = new();

    void toggleExpanded() => isExpanded = !isExpanded;

    void toggleAlbum(string albumKey)
    {
        if (expandedAlbums.Contains(albumKey))
            expandedAlbums.Remove(albumKey);
        else
            expandedAlbums.Add(albumKey);
    }
}
