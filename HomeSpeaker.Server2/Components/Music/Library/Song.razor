@using HomeSpeaker.Server2.Services
@using Microsoft.JSInterop
@inject HomeSpeakerService svc
@inject ILogger<Song> logger
@inject IJSRuntime JsRuntime

@if (SongViewModel == null)
{
    <div class="glass-empty">Nothing to see here...</div>
}
else
{
    <div class="glass-song">
        <div class="glass-row @(showDetails ? "is-active" : "")" @onclick=toggleDetailsView>
            <div class="glass-row-text">
                <div class="glass-row-title">@SongViewModel.Name</div>
                @if (ShowArtist && (!string.IsNullOrEmpty(SongViewModel.Artist) || !string.IsNullOrEmpty(SongViewModel.Album)))
                {
                    <div class="glass-row-sub">@(string.Join(" • ", new[] { SongViewModel.Artist, SongViewModel.Album }.Where(x => !string.IsNullOrEmpty(x))))</div>
                }
                @if (ShowFolder && !string.IsNullOrWhiteSpace(SongViewModel.Folder))
                {
                    <div class="glass-row-sub">
                        <i class="fas fa-folder me-1" aria-hidden="true"></i>@SongViewModel.Folder
                    </div>
                }
            </div>
            <div class="glass-row-actions">
                <button @onclick:stopPropagation="true" @onclick=toggleDetailsView class="hs-icon-btn hs-icon-btn--filled" title="@(showDetails ? "Hide details" : "Show details")" aria-label="@(showDetails ? "Hide details" : "Show details")" aria-expanded="@(showDetails ? "true" : "false")">
                    <i class="fas @(showDetails ? "fa-chevron-up" : "fa-chevron-down")" aria-hidden="true"></i>
                </button>
                @* The menus sit inside the row, so their clicks must not reach the row's toggle. *@
                <span class="glass-contents" @onclick:stopPropagation="true">
                    <PlayButtonWithDropdown Song="SongViewModel" />
                    <PlusButtonWithMenu Song="SongViewModel" />
                </span>
            </div>
        </div>

        @if (showDetails)
        {
            <div class="glass-row-details">
                <button class="glass-btn glass-btn--ghost" @onclick:stopPropagation="true" @onclick=toggleEditModalVisibility>
                    <i class="fas fa-pencil" aria-hidden="true"></i>Edit
                </button>
                <button class="glass-btn glass-btn--danger" @onclick:stopPropagation="true" @onclick=delete>
                    <i class="fas fa-trash" aria-hidden="true"></i>Delete
                </button>
            </div>
        }
    </div>
}

@if (!isEditModalHidden)
{
    @* Native dialog: it renders in the browser top layer (above the glass panel) and idleController can close it
       when the screen goes ambient; @onclose then resets this component's state. *@
    <dialog id="@editDialogId" class="glass-dialog" aria-labelledby="@(editDialogId + "-title")"
            @oncancel="cancelEdit" @oncancel:preventDefault="true" @onclose="cancelEdit">
        <h2 class="glass-dialog-title" id="@(editDialogId + "-title")">Edit Song</h2>
        <div class="glass-dialog-body">
            <label class="glass-field">
                <span>Title</span>
                <input type="text" class="glass-input" @bind="editedName" />
            </label>
            <label class="glass-field">
                <span>Artist</span>
                <input type="text" class="glass-input" @bind="editedArtist" />
            </label>
            <label class="glass-field">
                <span>Album</span>
                <input type="text" class="glass-input" @bind="editedAlbum" />
            </label>
        </div>
        <div class="glass-dialog-actions">
            <button type="button" class="glass-btn glass-btn--ghost" @onclick=cancelEdit>Cancel</button>
            <button type="button" class="glass-btn" @onclick=saveEdit>Save</button>
        </div>
    </dialog>
}


@code {
    [Parameter]
    public SongViewModel? SongViewModel { get; set; }

    [Parameter]
    public bool ShowFolder { get; set; }

    [Parameter]
    public bool ShowArtist { get; set; }

    [Parameter]
    public EventCallback<int> OnDeleted { get; set; }

    [Parameter]
    public EventCallback OnUpdated { get; set; }

    private bool showDetails { get; set; }
    private bool isEditModalHidden = true;
    private bool editDialogNeedsOpen;
    private readonly string editDialogId = "songEditDialog-" + Guid.NewGuid().ToString("N");
    private string editedName = string.Empty;
    private string editedArtist = string.Empty;
    private string editedAlbum = string.Empty;

    private void toggleDetailsView() => showDetails = !showDetails;

    async Task delete()
    {
        bool confirmed = await JsRuntime.InvokeAsync<bool>("confirm", "Are you sure?");
        if (confirmed && SongViewModel != null)
        {
            await svc.DeleteSongAsync(SongViewModel.SongId);
            await OnDeleted.InvokeAsync(SongViewModel.SongId);
            showDetails = false;
        }
    }

    void toggleEditModalVisibility()
    {
        if (isEditModalHidden && SongViewModel != null)
        {
            // Opening modal - populate with current values
            editedName = SongViewModel.Name;
            editedArtist = SongViewModel.Artist;
            editedAlbum = SongViewModel.Album;
        }
        isEditModalHidden = !isEditModalHidden;
        editDialogNeedsOpen = !isEditModalHidden;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!editDialogNeedsOpen)
        {
            return;
        }

        editDialogNeedsOpen = false;
        try
        {
            await JsRuntime.InvokeVoidAsync("eval", $"document.getElementById('{editDialogId}')?.showModal()");
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException)
        {
            // Dialog could not be opened (circuit gone or script error): keep the UI consistent.
            isEditModalHidden = true;
            StateHasChanged();
        }
    }

    void cancelEdit()
    {
        isEditModalHidden = true;
    }

    async Task saveEdit()
    {
        try
        {
            if (SongViewModel is null)
            {
                return;
            }

            await svc.UpdateSongAsync(SongViewModel.SongId, editedName, editedArtist, editedAlbum);

            // Update the local model
            SongViewModel.Name = editedName;
            SongViewModel.Artist = editedArtist;
            SongViewModel.Album = editedAlbum;

            isEditModalHidden = true;
            await OnUpdated.InvokeAsync();
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error updating song");
        }
    }
}
