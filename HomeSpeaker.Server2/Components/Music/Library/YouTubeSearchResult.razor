@using HomeSpeaker.Server2.Services.YouTube
@inject ILogger<YouTubeSearchResult> logger
@inject HomeSpeakerService svc

@if (SearchResult == null)
{
    <div class="glass-empty">Nothing to see here</div>
}
else
{
    <div class="glass-row">
        <img class="glass-row-art glass-row-art--wide" src="@SearchResult.Thumbnail" alt="" loading="lazy">
        <div class="glass-row-text">
            <a class="glass-row-title" href="@SearchResult.Url">@SearchResult.Title</a>
            <div class="glass-row-sub">by @SearchResult.Author (@SearchResult.Duration)</div>
        </div>
        <div class="glass-row-actions">
            @if (isStreaming)
            {
                <button class="hs-icon-btn hs-icon-btn--filled" @onclick=stopStreamAsync title="Stop" aria-label="Stop">
                    <i class="fas fa-stop" aria-hidden="true"></i>
                </button>
            }
            else
            {
                <button class="hs-icon-btn hs-icon-btn--filled" @onclick=playStreamAsync title="Preview" aria-label="Preview">
                    <i class="fas fa-play" aria-hidden="true"></i>
                </button>
            }
            @switch (Download?.Status)
            {
                case YouTubeDownloadStatus.Queued:
                    <span class="youtube-download-status" title="Waiting to download">Waiting</span>
                    break;
                case YouTubeDownloadStatus.Downloading:
                    <progress class="glass-progress" value="@Download.Progress" aria-label="Downloading"></progress>
                    break;
                case YouTubeDownloadStatus.Done or YouTubeDownloadStatus.AlreadyHad:
                    <span class="glass-row-done" title="Downloaded" role="img" aria-label="Downloaded"><i class="fas fa-check" aria-hidden="true"></i></span>
                    break;
                default:
                    <button class="hs-icon-btn hs-icon-btn--filled" @onclick=cacheVideoAsync disabled="@(!FfmpegAvailable)"
                            title="@downloadLabel" aria-label="@downloadLabel">
                        <i class="fas @(Download?.Status == YouTubeDownloadStatus.Failed ? "fa-rotate-right" : "fa-cloud-arrow-down")" aria-hidden="true"></i>
                    </button>
                    break;
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public VideoDto? SearchResult { get; set; }

    [Parameter]
    public bool FfmpegAvailable { get; set; } = true;

    /// <summary>This video's entry in the download queue, if it has been queued.</summary>
    [Parameter]
    public YouTubeDownload? Download { get; set; }

    [Parameter]
    public EventCallback<VideoDto> OnDownload { get; set; }

    bool isStreaming = false;

    string downloadLabel => !FfmpegAvailable ? "ffmpeg not available"
        : Download?.Status == YouTubeDownloadStatus.Failed ? $"Download failed ({Download.Error}); try again"
        : "Download";

    async Task playStreamAsync()
    {
        if (SearchResult == null) return;
        try
        {
            isStreaming = true;
            await svc.PlayYouTubeStreamAsync(SearchResult.Id, SearchResult.Title);
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error streaming {title}", SearchResult?.Title);
            isStreaming = false;
        }
    }

    async Task stopStreamAsync()
    {
        try
        {
            await svc.StopPlayingAsync();
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error stopping stream");
        }
        finally
        {
            isStreaming = false;
        }
    }

    async Task cacheVideoAsync()
    {
        if (SearchResult != null)
        {
            await OnDownload.InvokeAsync(SearchResult);
        }
    }
}
