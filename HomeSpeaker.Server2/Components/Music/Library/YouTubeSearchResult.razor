@inject ILogger<YouTubeSearchResult> logger
@inject HomeSpeakerService svc

@if (SearchResult == null)
{
    <div class="glass-empty">Nothing to see here</div>
}
else
{
    <div class="glass-row">
        <img class="glass-row-art glass-row-art--wide" src="@SearchResult.Thumbnail" alt="" loading="lazy">
        <div class="glass-row-text">
            <a class="glass-row-title" href="@SearchResult.Url">@SearchResult.Title</a>
            <div class="glass-row-sub">by @SearchResult.Author (@SearchResult.Duration)</div>
        </div>
        <div class="glass-row-actions">
            @if (isStreaming)
            {
                <button class="hs-icon-btn hs-icon-btn--filled" @onclick=stopStreamAsync title="Stop" aria-label="Stop">
                    <i class="fas fa-stop" aria-hidden="true"></i>
                </button>
            }
            else
            {
                <button class="hs-icon-btn hs-icon-btn--filled" @onclick=playStreamAsync title="Preview" aria-label="Preview">
                    <i class="fas fa-play" aria-hidden="true"></i>
                </button>
            }
            @if (isDownloading)
            {
                <progress class="glass-progress" value="@progressValue" />
            }
            else if (isComplete)
            {
                <span class="glass-row-done" title="Downloaded" role="img" aria-label="Downloaded"><i class="fas fa-check" aria-hidden="true"></i></span>
            }
            else
            {
                <button class="hs-icon-btn hs-icon-btn--filled" @onclick=cacheVideoAsync disabled="@(!FfmpegAvailable)" title="@(FfmpegAvailable ? "Download" : "ffmpeg not available")" aria-label="@(FfmpegAvailable ? "Download" : "ffmpeg not available")">
                    <i class="fas fa-cloud-arrow-down" aria-hidden="true"></i>
                </button>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public VideoDto? SearchResult { get; set; }

    [Parameter]
    public bool FfmpegAvailable { get; set; } = true;

    bool isDownloading = false;
    bool isComplete = false;
    bool isStreaming = false;
    double progressValue;

    async Task playStreamAsync()
    {
        if (SearchResult == null) return;
        try
        {
            isStreaming = true;
            await svc.PlayYouTubeStreamAsync(SearchResult.Id, SearchResult.Title);
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error streaming {title}", SearchResult?.Title);
            isStreaming = false;
        }
    }

    async Task stopStreamAsync()
    {
        try
        {
            await svc.StopPlayingAsync();
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error stopping stream");
        }
        finally
        {
            isStreaming = false;
        }
    }

    async Task cacheVideoAsync()
    {
        if (SearchResult == null)
        {
            return;
        }

        isDownloading = true;
        isComplete = false;
        progressValue = 0;

        var progress = new Progress<double>(value =>
        {
            progressValue = value;
            _ = InvokeAsync(StateHasChanged);
        });

        try
        {
            await svc.CacheVideoAsync(SearchResult, progress);
            isComplete = true;
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error caching {title}", SearchResult.Title);
        }
        finally
        {
            isDownloading = false;
        }
    }
}
