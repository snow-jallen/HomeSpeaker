@using HomeSpeaker.Server2.Services
@using HomeSpeaker.Server2.Models
@using Microsoft.JSInterop
@using System.Linq
@inject IPlaybackModeService playbackModeService
@inject HomeSpeakerService homeSpeakerService
@inject ILocalQueueService localQueueService
@inject IJSRuntime JsRuntime
@implements IAsyncDisposable

<div class="position-relative d-inline-block" id="@menuAnchorId">
    <button @onclick="ToggleMenu" class="hs-icon-btn hs-icon-btn--filled" title="Play" aria-label="Play" aria-haspopup="menu" aria-expanded="@(showMenu ? "true" : "false")">
        <i class="fas fa-play" aria-hidden="true"></i>
    </button>@if (showMenu)
    {
        <div class="glass-menu position-absolute" role="menu" style="@dropdownPositionStyle z-index: 10000;">
            <button class="glass-menu-item" role="menuitem" @onclick="PlayOnServer">
                <i class="fas fa-server" aria-hidden="true"></i>Play on Server
            </button>
            <button class="glass-menu-item" role="menuitem" @onclick="PlayLocally">
                <i class="fas fa-headphones" aria-hidden="true"></i>Stream to Device
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public SongViewModel? Song { get; set; }
    [Parameter] public string? PlaylistName { get; set; }
    [Parameter] public string? FolderName { get; set; }
    [Parameter] public IEnumerable<SongViewModel>? Songs { get; set; }
    [Parameter] public EventCallback OnPlayStarted { get; set; }    private bool showMenu = false;
    private bool dismissAttached;
    private DotNetObjectReference<PlayButtonWithDropdown>? dotNetRef;
    private readonly string menuAnchorId = $"mb{Guid.NewGuid():N}";
    private string dropdownPositionStyle = "top: 100%; right: 0;";

    private async Task ToggleMenu()
    {
        showMenu = !showMenu;
        if (showMenu)
        {
            await UpdateDropdownPosition();
        }
        StateHasChanged();
    }

    private void CloseMenu()
    {
        showMenu = false;
        StateHasChanged();
    }

    private async Task UpdateDropdownPosition()
    {
        try
        {
            // Use JavaScript to check positioning and return the appropriate style
            var positionStyle = await JsRuntime.InvokeAsync<string>("eval", $@"
                (function(element) {{
                    var rect = element.getBoundingClientRect();
                    var viewportWidth = window.innerWidth;
                    var dropdownWidth = 220; // Approximate width of dropdown
                    var dropdownHeight = 260; // Approximate height of dropdown
                    var main = element.closest('.hs-main');
                    var bottomLimit = main ? main.getBoundingClientRect().bottom : window.innerHeight;
                    var topLimit = main ? main.getBoundingClientRect().top : 0;
                    var horizontal = (rect.right + dropdownWidth > viewportWidth) ? 'right: 0;' : 'left: 0;';
                    var openUp = (rect.bottom + dropdownHeight > bottomLimit) && (rect.top - topLimit > bottomLimit - rect.bottom);
                    return (openUp ? 'bottom: 100%; ' : 'top: 100%; ') + horizontal;
                }})(document.getElementById('{menuAnchorId}'))");
            
            dropdownPositionStyle = positionStyle;
        }        catch
        {
            // Fallback to default positioning if JS call fails
            dropdownPositionStyle = "top: 100%; right: 0;";
        }
    }

    private async Task PlayOnServer()
    {
        showMenu = false;
        StateHasChanged();
        
        if (Song != null)
        {
            await homeSpeakerService.PlaySongAsync(Song.SongId);
        }
        else if (!string.IsNullOrEmpty(PlaylistName))
        {
            await homeSpeakerService.PlayPlaylistAsync(PlaylistName);
        }
        else if (!string.IsNullOrEmpty(FolderName))
        {
            await homeSpeakerService.PlayFolderAsync(FolderName);
        }
        else if (Songs != null)
        {
            await homeSpeakerService.PlaySongsAsync(Songs);
        }
        
        await OnPlayStarted.InvokeAsync();
    }    private async Task PlayLocally()
    {
        showMenu = false;
        StateHasChanged();
        
        try
        {
            if (Song != null)
            {
                await localQueueService.PlaySongAsync(Song);
            }
            else if (!string.IsNullOrEmpty(PlaylistName))
            {
                await PlayPlaylistLocallyAsync();
            }
            else if (!string.IsNullOrEmpty(FolderName))
            {
                await PlayFolderLocallyAsync();
            }
            else if (Songs != null)
            {
                await localQueueService.PlaySongsAsync(Songs);
            }
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"Error playing locally: {ex.Message}");
        }
        
        await OnPlayStarted.InvokeAsync();
    }    private async Task PlayFolderLocallyAsync()
    {
        if (string.IsNullOrEmpty(FolderName)) return;
        
        try
        {
            // Get folder songs from server
            var folderSongs = await homeSpeakerService.GetSongsInFolder(FolderName);
            var songViewModels = folderSongs.ToList();
            
            if (songViewModels.Any())
            {
                await localQueueService.PlaySongsAsync(songViewModels);
            }
            else
            {
                await JsRuntime.InvokeVoidAsync("alert", $"Folder '{FolderName}' contains no songs.");
            }
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"Error playing folder locally: {ex.Message}");
        }
    }private async Task PlayPlaylistLocallyAsync()
    {
        if (string.IsNullOrEmpty(PlaylistName)) return;
        
        try
        {
            // Get playlist data from server
            var playlists = await homeSpeakerService.GetPlaylistsAsync();
            var playlist = playlists.FirstOrDefault(p => p.Name == PlaylistName);
            
            if (playlist == null)
            {
                await JsRuntime.InvokeVoidAsync("alert", $"Playlist '{PlaylistName}' not found.");
                return;
            }
            
            // Convert playlist songs to SongViewModels and play them locally
            var songViewModels = playlist.Songs.Select(s => s.ToSongViewModel()).ToList();
            
            if (songViewModels.Any())
            {
                await localQueueService.PlaySongsAsync(songViewModels);
            }
            else
            {
                await JsRuntime.InvokeVoidAsync("alert", $"Playlist '{PlaylistName}' is empty.");
            }
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"Error playing playlist locally: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Close on a tap/press outside the menu or Escape. Listens on the document, independent of any container's styling.
        if (showMenu && !dismissAttached)
        {
            dismissAttached = true;
            dotNetRef ??= DotNetObjectReference.Create(this);
            try
            {
                await JsRuntime.InvokeVoidAsync("menuDismiss.attach", menuAnchorId, dotNetRef);
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException)
            {
                dismissAttached = false;
            }
        }
        else if (!showMenu && dismissAttached)
        {
            await detachDismissAsync();
        }
    }

    [JSInvokable]
    public Task CloseFromOutside() => InvokeAsync(CloseMenu);

    private async Task detachDismissAsync()
    {
        dismissAttached = false;
        try
        {
            await JsRuntime.InvokeVoidAsync("menuDismiss.detach", menuAnchorId);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException)
        {
            // Circuit is gone: the listener went with the page.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (dismissAttached)
        {
            await detachDismissAsync();
        }
        dotNetRef?.Dispose();
    }
}

