@inject HomeSpeakerService svc
@inject PlayerStateService PlayerState
@implements IDisposable

<div class="play-controls@(Compact ? " play-controls--compact" : "")">
    <button @onclick="PlayOrStop"
            title="@(IsPlaying ? "Stop playing" : "Resume playing")"
            aria-label="@(IsPlaying ? "Stop playing" : "Resume playing")"
            class="hs-play-btn play-button">
        <i class="fas @(IsPlaying ? "fa-stop" : "fa-play")" aria-hidden="true"></i>
    </button>
    <button @onclick=Skip title="Skip to next song" aria-label="Skip to next song" class="hs-icon-btn hs-icon-btn--filled skip-button">
        <i class="fas fa-forward" aria-hidden="true"></i>
    </button>
</div>

@code {
    /// <summary>Smaller buttons for the NavMenu/NoTopLayout sidebar on small screens.</summary>
    [Parameter] public bool Compact { get; set; }

    bool IsPlaying => PlayerState.Status?.StillPlaying == true;

    protected override void OnInitialized()
    {
        PlayerState.StateChanged += OnPlayerStateChanged;
    }

    async Task PlayOrStop()
    {
        if (IsPlaying)
        {
            await svc.StopPlayingAsync();
            return;
        }

        await svc.ResumePlayAsync();
    }

    async Task Skip() => await svc.SkipToNextAsync();

    private void OnPlayerStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        PlayerState.StateChanged -= OnPlayerStateChanged;
    }
}
