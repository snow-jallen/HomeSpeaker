@inject HomeSpeakerService svc
@inject IJSRuntime JsRuntime

<div class="glass-menu" role="menu">
    <h6 class="glass-menu-header">Add to...</h6>
    <button class="glass-menu-item" role="menuitem" @onclick="AddToQueue">
        <i class="fas fa-list" aria-hidden="true"></i>Queue
    </button>
    <div class="glass-menu-divider"></div>

    @if (allPlaylists == null)
    {
        <div class="glass-menu-text">Loading playlists...</div>
    }
    else if (!allPlaylists.Any())
    {
        <div class="glass-menu-text">No playlists available</div>
        <div class="glass-menu-divider"></div>
        <button class="glass-menu-item" role="menuitem" @onclick="CreateNewPlaylist">
            <i class="fas fa-plus" aria-hidden="true"></i>Create new playlist...
        </button>
    }
    else
    {
        <h6 class="glass-menu-header">Playlists:</h6>
        @foreach (var playlist in allPlaylists)
        {
            <button class="glass-menu-item" role="menuitem" @onclick="@(() => AddToPlaylist(playlist.Name))">
                <i class="fas fa-music" aria-hidden="true"></i>@playlist.Name
            </button>
        }
        <div class="glass-menu-divider"></div>
        <button class="glass-menu-item" role="menuitem" @onclick="CreateNewPlaylist">
            <i class="fas fa-plus" aria-hidden="true"></i>Create new playlist...
        </button>
    }
</div>

<!-- Native <dialog> renders in the browser top layer — above all z-index and stacking contexts -->
<dialog id="@_dialogId" class="glass-dialog">
    <div class="glass-dialog-title">
        <span>New Playlist</span>
        <button type="button" class="hs-icon-btn hs-icon-btn--filled" @onclick="CancelCreatePlaylist" aria-label="Close" title="Close">
            <i class="fas fa-xmark" aria-hidden="true"></i>
        </button>
    </div>
    <input type="text" id="@_inputId" class="glass-input"
           @bind="newPlaylistName" @bind:event="oninput" @onkeydown="OnKeyPress"
           placeholder="Playlist name..." aria-label="Playlist name" />
    <div class="glass-dialog-actions">
        <button type="button" class="glass-btn glass-btn--ghost" @onclick="CancelCreatePlaylist">Cancel</button>
        <button type="button" class="glass-btn" @onclick="SaveNewPlaylist">Create</button>
    </div>
</dialog>

@code {
    [Parameter] public List<SongViewModel>? Songs { get; set; }
    [Parameter] public SongViewModel? Song { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private IEnumerable<Playlist>? allPlaylists;
    private string newPlaylistName = "";

    // Unique IDs so multiple instances on the page don't collide
    private readonly string _dialogId = $"pd{Guid.NewGuid():N}";
    private readonly string _inputId  = $"pi{Guid.NewGuid():N}";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            allPlaylists = await svc.GetPlaylistsAsync();
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("console.error", $"Error loading playlists: {ex.Message}");
            allPlaylists = Enumerable.Empty<Playlist>();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Prevent the browser closing the dialog on Escape without us updating Blazor state
            await JsRuntime.InvokeVoidAsync("eval", $@"
                document.getElementById('{_dialogId}')
                    .addEventListener('cancel', function(e) {{ e.preventDefault(); }});
            ");
        }
    }

    private async Task AddToQueue()
    {
        try
        {
            if (Songs != null && Songs.Any())
            {
                foreach (var song in Songs)
                    await svc.EnqueueSongAsync(song.SongId);
            }
            else if (Song != null)
            {
                await svc.EnqueueSongAsync(Song.SongId);
            }
            await OnClosed.InvokeAsync();
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"Error adding to queue: {ex.Message}");
        }
    }

    private async Task AddToPlaylist(string playlistName)
    {
        try
        {
            if (Songs != null && Songs.Any())
            {
                foreach (var song in Songs)
                {
                    if (!string.IsNullOrEmpty(song.Path))
                        await svc.AddToPlaylistAsync(playlistName, song.Path);
                }
            }
            else if (Song != null && !string.IsNullOrEmpty(Song.Path))
            {
                await svc.AddToPlaylistAsync(playlistName, Song.Path);
            }
            await OnClosed.InvokeAsync();
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"Error adding to playlist: {ex.Message}");
        }
    }

    private async Task CreateNewPlaylist()
    {
        newPlaylistName = "";
        StateHasChanged();
        try
        {
            await JsRuntime.InvokeVoidAsync("eval", $@"
                document.getElementById('{_dialogId}').showModal();
                setTimeout(function() {{ document.getElementById('{_inputId}')?.focus(); }}, 0);
            ");
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException)
        {
            // Dialog could not be opened: reset state and let the parent close the menu so the UI stays consistent.
            newPlaylistName = "";
            await OnClosed.InvokeAsync();
        }
    }

    private async Task CancelCreatePlaylist()
    {
        newPlaylistName = "";
        StateHasChanged();
        await JsRuntime.InvokeVoidAsync("eval", $"document.getElementById('{_dialogId}').close()");
    }

    private async Task SaveNewPlaylist()
    {
        if (string.IsNullOrWhiteSpace(newPlaylistName))
        {
            await JsRuntime.InvokeVoidAsync("alert", "Please enter a playlist name.");
            return;
        }

        try
        {
            if (Songs != null && Songs.Any())
            {
                foreach (var song in Songs)
                {
                    if (!string.IsNullOrEmpty(song.Path))
                        await svc.AddToPlaylistAsync(newPlaylistName.Trim(), song.Path);
                }
            }
            else if (Song != null && !string.IsNullOrEmpty(Song.Path))
            {
                await svc.AddToPlaylistAsync(newPlaylistName.Trim(), Song.Path);
            }

            newPlaylistName = "";
            await JsRuntime.InvokeVoidAsync("eval", $"document.getElementById('{_dialogId}').close()");
            await OnClosed.InvokeAsync();
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"Error creating playlist: {ex.Message}");
        }
    }

    private async Task OnKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SaveNewPlaylist();
        else if (e.Key == "Escape")
            await CancelCreatePlaylist();
    }
}
