# Production Environment Variables Template
# Copy this to .env and fill in the actual values
# This file can be committed to git as it contains no secrets

# Govee API Key - get from Govee Developer Portal
GOVEE_API_KEY=your_govee_api_key_here

# AirPlay device name - set by GitHub Actions based on deployment target
AIRPLAY_NAME=HomeSpeaker

# Add other environment variables as needed
# NIGHTSCOUT_URL=your_nightscout_url_here
# CERTIFICATE_PASSWORD=your_certificate_password_here

# --- iOS push notifications (APNs) ---
# All four Apns values below are REQUIRED for pushes to send. If any is missing the
# server logs "push notifications are not configured" and silently sends nothing.
#
# Topic   = the iOS app's bundle identifier (NOT a URL).
# TeamId  = 10-character Apple Developer Team ID (Membership page).
# KeyId   = 10-character Key ID of the APNs Auth Key (.p8) from Certificates, IDs & Profiles → Keys.
# PrivateKeyBase64 = the .p8 auth key file, base64-encoded as a single line. Generate with:
#                      base64 -w0 AuthKey_XXXXXXXXXX.p8     (Linux)
#                      base64 -i AuthKey_XXXXXXXXXX.p8      (macOS)
#                    (Alternatively set PushNotifications__Apns__PrivateKeyPath to a .p8 file path.)
# PushNotifications__Apns__Topic=com.example.HomeSpeaker
# PushNotifications__Apns__TeamId=your_apple_team_id_here
# PushNotifications__Apns__KeyId=your_apns_key_id_here
# PushNotifications__Apns__PrivateKeyBase64=base64_encoded_auth_key_p8_here
#
# UseSandbox selects the APNs environment and MUST match how the iOS app was BUILT —
# the .p8 key is the SAME for both environments, so the key does NOT determine this:
#   true  = development builds run from Xcode onto a device (default).
#   false = TestFlight or App Store builds. Using the wrong value yields BadDeviceToken
#           and the server will deactivate the device.
# PushNotifications__Apns__UseSandbox=true
#
# Optional: how often (seconds) the background worker evaluates health alerts. Default 120, min 30.
# PushNotifications__PollIntervalSeconds=120
