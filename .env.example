# Copy to .env (docker compose reads it automatically). Every value is optional unless noted.

# Folder on the host that holds your MP3s (and HomeSpeaker.db)
# MUSIC_DIR=./music

# Time zone, e.g. America/Denver
# TZ=Etc/UTC

# Host port for the web UI
# HTTP_PORT=80

# Host user id; the PulseAudio socket is /run/user/<PUID>/pulse
# PUID=1000

# Name shown to AirPlay senders (only used with the airplay profile)
# AIRPLAY_NAME=HomeSpeaker

# Image to run
# HOMESPEAKER_IMAGE=ghcr.io/snow-jallen/homespeaker:latest

# OpenTelemetry endpoint. With the telemetry profile use http://aspire-dashboard:18889
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional compose profiles, comma separated: airplay, telemetry
# COMPOSE_PROFILES=airplay

# HTTPS overlay only (docker-compose.https.yml): folder containing certificate.pfx (required there)
# CERT_DIR=/home/piuser/cert
